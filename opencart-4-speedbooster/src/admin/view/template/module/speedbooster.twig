{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" id="button-purge" data-bs-toggle="tooltip" title="{{ button_purge }}" class="btn btn-warning"><i class="fa-solid fa-broom"></i> {{ button_purge }}</button>
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-gauge-high"></i> {{ text_info }}</div>
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_speedbooster_status" value="0"/><input type="checkbox" name="module_speedbooster_status" value="1" id="input-status" class="form-check-input"{% if module_speedbooster_status %} checked{% endif %}/></div></div>
          </div>
          <fieldset>
            <legend>{{ text_cache }}</legend>
            <div class="row mb-3">
              <label for="input-cache-status" class="col-sm-3 col-form-label">{{ entry_cache_status }}</label>
              <div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_speedbooster_cache_status" value="0"/><input type="checkbox" name="module_speedbooster_cache_status" value="1" id="input-cache-status" class="form-check-input"{% if module_speedbooster_cache_status %} checked{% endif %}/></div></div>
            </div>
            <div class="row mb-3">
              <label for="input-ttl" class="col-sm-3 col-form-label">{{ entry_cache_ttl }}</label>
              <div class="col-sm-9">
                <input type="number" name="module_speedbooster_cache_ttl" value="{{ module_speedbooster_cache_ttl }}" min="1" max="10080" id="input-ttl" class="form-control" style="max-width: 10rem;"/>
                <div id="error-ttl" class="invalid-feedback"></div>
                <div class="form-text">{{ help_cache_ttl }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-exclude" class="col-sm-3 col-form-label">{{ entry_cache_exclude }}</label>
              <div class="col-sm-9">
                <textarea name="module_speedbooster_cache_exclude" rows="6" id="input-exclude" class="form-control font-monospace">{{ module_speedbooster_cache_exclude|e }}</textarea>
                <div class="form-text">{{ help_cache_exclude }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-vary" class="col-sm-3 col-form-label">{{ entry_vary_cookies }}</label>
              <div class="col-sm-9">
                <input type="text" name="module_speedbooster_vary_cookies" value="{{ module_speedbooster_vary_cookies|e }}" id="input-vary" class="form-control font-monospace"/>
                <div class="form-text">{{ help_vary_cookies }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_frontend }}</legend>
            <div class="row mb-3">
              <label for="input-lazy" class="col-sm-3 col-form-label">{{ entry_lazy_status }}</label>
              <div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_speedbooster_lazy_status" value="0"/><input type="checkbox" name="module_speedbooster_lazy_status" value="1" id="input-lazy" class="form-check-input"{% if module_speedbooster_lazy_status %} checked{% endif %}/></div></div>
            </div>
            <div class="row mb-3">
              <label for="input-lazy-skip" class="col-sm-3 col-form-label">{{ entry_lazy_skip }}</label>
              <div class="col-sm-9">
                <input type="number" name="module_speedbooster_lazy_skip" value="{{ module_speedbooster_lazy_skip }}" min="0" max="20" id="input-lazy-skip" class="form-control" style="max-width: 10rem;"/>
                <div class="form-text">{{ help_lazy_skip }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-minify" class="col-sm-3 col-form-label">{{ entry_minify_status }}</label>
              <div class="col-sm-9">
                <div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_speedbooster_minify_status" value="0"/><input type="checkbox" name="module_speedbooster_minify_status" value="1" id="input-minify" class="form-check-input"{% if module_speedbooster_minify_status %} checked{% endif %}/></div>
                <div class="form-text">{{ help_minify }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-preconnect" class="col-sm-3 col-form-label">{{ entry_preconnect }}</label>
              <div class="col-sm-9">
                <textarea name="module_speedbooster_preconnect" rows="3" id="input-preconnect" class="form-control font-monospace" placeholder="https://fonts.gstatic.com">{{ module_speedbooster_preconnect|e }}</textarea>
                <div id="error-preconnect" class="invalid-feedback"></div>
                <div class="form-text">{{ help_preconnect }}</div>
              </div>
            </div>
          </fieldset>
        </form>
        <div class="text-body-secondary small"><i class="fa-solid fa-flask"></i> {{ text_test }}</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <div class="float-end"><button type="button" id="button-recheck" class="btn btn-sm btn-light"><i class="fa-solid fa-rotate"></i> {{ button_recheck }}</button></div>
        <i class="fa-solid fa-stethoscope"></i> {{ text_report }}
      </div>
      <div class="card-body p-0" id="speedbooster-report"><p class="p-3 mb-0 text-body-secondary"><i class="fa-solid fa-circle-notch fa-spin"></i> {{ text_loading }}</p></div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
function speedboosterAlert(json) {
    $('.alert-dismissible').remove();

    if (json['error']) {
        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }

    if (json['success']) {
        $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }
}

function speedboosterReport() {
    $('#speedbooster-report').load('{{ report|replace({'&amp;': '&'}) }}');
}

speedboosterReport();

$('#button-recheck').on('click', speedboosterReport);

$('#button-purge').on('click', function() {
    var button = $(this);

    $.ajax({
        url: '{{ purge|replace({'&amp;': '&'}) }}',
        dataType: 'json',
        beforeSend: function() { button.button('loading'); },
        complete: function() { button.button('reset'); },
        success: function(json) {
            speedboosterAlert(json);
            speedboosterReport();
        }
    });
});

$('#speedbooster-report').on('click', '[data-fix]', function() {
    if (!confirm('{{ text_confirm|escape('js') }}')) {
        return;
    }

    var button = $(this);

    $.ajax({
        url: '{{ fix|replace({'&amp;': '&'}) }}&type=' + encodeURIComponent(button.attr('data-fix')),
        dataType: 'json',
        beforeSend: function() { button.button('loading'); },
        success: function(json) {
            speedboosterAlert(json);
            speedboosterReport();
        }
    });
});

$('#form-module').on('submit', function() {
    setTimeout(speedboosterReport, 800);
});
//--></script>
{{ footer }}
