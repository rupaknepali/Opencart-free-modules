{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_count }} {{ text_note }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_stocklast_status" value="0"/>
                <input type="checkbox" name="module_stocklast_status" value="1" id="input-status" class="form-check-input"{% if module_stocklast_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-2 col-form-label fw-bold text-sm-end">{{ entry_mode }}</div>
            <div class="col-sm-10 pt-2">
              <div class="form-check">
                <input type="radio" name="module_stocklast_mode" value="last" id="input-mode-last" class="form-check-input"{% if module_stocklast_mode != 'hide' %} checked{% endif %}/>
                <label for="input-mode-last" class="form-check-label">{{ text_last }}</label>
              </div>
              <div class="form-check">
                <input type="radio" name="module_stocklast_mode" value="hide" id="input-mode-hide" class="form-check-input"{% if module_stocklast_mode == 'hide' %} checked{% endif %}/>
                <label for="input-mode-hide" class="form-check-label">{{ text_hide }}</label>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-2 col-form-label fw-bold text-sm-end">{{ text_pages }}</div>
            <div class="col-sm-10 pt-2">
              <div class="form-check">
                <input type="hidden" name="module_stocklast_category" value="0"/>
                <input type="checkbox" name="module_stocklast_category" value="1" id="input-category" class="form-check-input"{% if module_stocklast_category %} checked{% endif %}/>
                <label for="input-category" class="form-check-label">{{ text_category }}</label>
              </div>
              <div class="form-check">
                <input type="hidden" name="module_stocklast_search" value="0"/>
                <input type="checkbox" name="module_stocklast_search" value="1" id="input-search" class="form-check-input"{% if module_stocklast_search %} checked{% endif %}/>
                <label for="input-search" class="form-check-label">{{ text_search }}</label>
              </div>
              <div class="form-check">
                <input type="hidden" name="module_stocklast_manufacturer" value="0"/>
                <input type="checkbox" name="module_stocklast_manufacturer" value="1" id="input-manufacturer" class="form-check-input"{% if module_stocklast_manufacturer %} checked{% endif %}/>
                <label for="input-manufacturer" class="form-check-label">{{ text_manufacturer }}</label>
              </div>
              <div class="form-check">
                <input type="hidden" name="module_stocklast_modules" value="0"/>
                <input type="checkbox" name="module_stocklast_modules" value="1" id="input-modules" class="form-check-input"{% if module_stocklast_modules %} checked{% endif %}/>
                <label for="input-modules" class="form-check-label">{{ text_modules }}</label>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
