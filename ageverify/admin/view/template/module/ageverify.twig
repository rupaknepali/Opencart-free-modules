{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-age" class="col-sm-2 col-form-label">{{ entry_age }}</label>
            <div class="col-sm-10">
              <input type="number" name="module_ageverify_age" value="{{ module_ageverify_age }}" id="input-age" class="form-control" style="max-width: 12rem;"/>
              <div id="error-age" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ageverify_title" value="{{ module_ageverify_title }}" id="input-title" class="form-control"/>
              <div class="form-text">{{ help_title }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
            <div class="col-sm-10">
              <textarea name="module_ageverify_message" rows="3" id="input-message" class="form-control">{{ module_ageverify_message }}</textarea>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-yes" class="col-sm-2 col-form-label">{{ entry_yes }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ageverify_yes" value="{{ module_ageverify_yes }}" id="input-yes" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-no" class="col-sm-2 col-form-label">{{ entry_no }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ageverify_no" value="{{ module_ageverify_no }}" id="input-no" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-exit-url" class="col-sm-2 col-form-label">{{ entry_exit_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ageverify_exit_url" value="{{ module_ageverify_exit_url }}" id="input-exit-url" class="form-control"/>
              <div class="form-text">{{ help_exit_url }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-days" class="col-sm-2 col-form-label">{{ entry_days }}</label>
            <div class="col-sm-10">
              <input type="number" name="module_ageverify_days" value="{{ module_ageverify_days }}" id="input-days" class="form-control" style="max-width: 12rem;"/>
              <div class="form-text">{{ help_days }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_ageverify_status" value="0"/>
                <input type="checkbox" name="module_ageverify_status" value="1" id="input-status" class="form-check-input"{% if module_ageverify_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
