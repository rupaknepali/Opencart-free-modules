{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_cron_info|format(cron) }}</div>
    {% if not review_status %}
      <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_review_disabled }}</div>
    {% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ text_general }}</a></li>
          <li class="nav-item"><a href="#tab-email" data-bs-toggle="tab" class="nav-link">{{ text_email }}</a></li>
          <li class="nav-item"><a href="#tab-reminder" data-bs-toggle="tab" class="nav-link">{{ text_reminder }}</a></li>
          <li class="nav-item"><a href="#tab-report" data-bs-toggle="tab" class="nav-link">{{ text_report }}</a></li>
        </ul>
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_review_request_status" value="0"/>
                    <input type="checkbox" name="module_review_request_status" value="1" id="input-status" class="form-check-input"{% if module_review_request_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
                <div class="col-sm-10">
                  <div id="input-order-status" class="form-control" style="height: 150px; overflow: auto;">
                    {% for order_status in order_statuses %}
                      <div class="form-check">
                        <input type="checkbox" name="module_review_request_order_status[]" value="{{ order_status.order_status_id }}" id="input-order-status-{{ order_status.order_status_id }}" class="form-check-input"{% if order_status.order_status_id in module_review_request_order_status %} checked{% endif %}/> <label for="input-order-status-{{ order_status.order_status_id }}" class="form-check-label">{{ order_status.name }}</label>
                      </div>
                    {% endfor %}
                  </div>
                  <div class="form-text">{{ help_order_status }}</div>
                  <div id="error-order-status" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-delay" class="col-sm-2 col-form-label">{{ entry_delay }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="number" min="1" max="60" name="module_review_request_delay" value="{{ module_review_request_delay }}" id="input-delay" class="form-control"/>
                    <span class="input-group-text">{{ text_days }}</span>
                  </div>
                  <div class="form-text">{{ help_delay }}</div>
                  <div id="error-delay" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_approve }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_review_request_approve" value="0"/>
                    <input type="checkbox" name="module_review_request_approve" value="1" id="input-approve" class="form-check-input"{% if module_review_request_approve %} checked{% endif %}/>
                  </div>
                  <div class="form-text">{{ help_approve }} {{ text_moderation|format(reviews) }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-start" class="col-sm-2 col-form-label">{{ entry_start }}</label>
                <div class="col-sm-10">
                  <input type="date" name="module_review_request_start" value="{{ module_review_request_start }}" id="input-start" class="form-control"/>
                  <div class="form-text">{{ help_start }}</div>
                  <div id="error-start" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-retention" class="col-sm-2 col-form-label">{{ entry_retention }}</label>
                <div class="col-sm-10">
                  <input type="number" min="90" name="module_review_request_retention" value="{{ module_review_request_retention }}" id="input-retention" class="form-control"/>
                  <div class="form-text">{{ help_retention }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-bcc" class="col-sm-2 col-form-label">{{ entry_bcc }}</label>
                <div class="col-sm-10">
                  <input type="email" name="module_review_request_bcc" value="{{ module_review_request_bcc }}" id="input-bcc" class="form-control"/>
                  <div class="form-text">{{ help_bcc }}</div>
                  <div id="error-bcc" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
            <div id="tab-email" class="tab-pane">
              <div class="alert alert-light">{{ text_placeholders }}</div>
              <div class="row mb-3 required">
                <label for="input-subject" class="col-sm-2 col-form-label">{{ entry_subject }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_review_request_subject" value="{{ module_review_request_subject }}" id="input-subject" class="form-control"/>
                  <div id="error-subject" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
                <div class="col-sm-10">
                  <textarea name="module_review_request_message" rows="10" id="input-message" data-oc-toggle="ckeditor" class="form-control">{{ module_review_request_message }}</textarea>
                  <div id="error-message" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
            <div id="tab-reminder" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_reminder }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_review_request_reminder" value="0"/>
                    <input type="checkbox" name="module_review_request_reminder" value="1" id="input-reminder" class="form-check-input"{% if module_review_request_reminder %} checked{% endif %}/>
                  </div>
                  <div class="form-text">{{ help_reminder }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-reminder-delay" class="col-sm-2 col-form-label">{{ entry_reminder_delay }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="number" min="1" max="30" name="module_review_request_reminder_delay" value="{{ module_review_request_reminder_delay }}" id="input-reminder-delay" class="form-control"/>
                    <span class="input-group-text">{{ text_days }}</span>
                  </div>
                  <div class="form-text">{{ help_reminder_delay }}</div>
                  <div id="error-reminder-delay" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-reminder-subject" class="col-sm-2 col-form-label">{{ entry_subject }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_review_request_reminder_subject" value="{{ module_review_request_reminder_subject }}" id="input-reminder-subject" class="form-control"/>
                  <div id="error-reminder-subject" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-reminder-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
                <div class="col-sm-10">
                  <textarea name="module_review_request_reminder_message" rows="10" id="input-reminder-message" data-oc-toggle="ckeditor" class="form-control">{{ module_review_request_reminder_message }}</textarea>
                  <div id="error-reminder-message" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
            <div id="tab-report" class="tab-pane">
              <div class="row text-center mb-4">
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_requested }}</div><div class="text-muted">{{ text_requested }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_clicked }}</div><div class="text-muted">{{ text_clicked }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_reviews }}</div><div class="text-muted">{{ text_reviews }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_rate }}</div><div class="text-muted">{{ text_rate }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_rating }}</div><div class="text-muted">{{ text_rating }}</div></div></div>
              </div>
              <div class="row g-2 mb-3">
                <div class="col-sm-4"><input type="text" value="" placeholder="{{ entry_filter_email }}" id="filter-email" class="form-control"/></div>
                <div class="col-sm-3"><input type="text" value="" placeholder="{{ entry_filter_order_id }}" id="filter-order-id" class="form-control"/></div>
                <div class="col-sm-3">
                  <select id="filter-status" class="form-select">
                    <option value="">{{ text_all }}</option>
                    {% for status_id in 1..4 %}
                      <option value="{{ status_id }}">{{ attribute(_context, 'text_status_' ~ status_id) }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-sm-2 d-grid"><button type="button" id="button-filter" class="btn btn-light"><i class="fa-solid fa-filter"></i> {{ button_filter }}</button></div>
              </div>
              <div id="request-list">{{ list }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('textarea[data-oc-toggle=\'ckeditor\']').ckeditor({
    allowedContent: true
});

$('#request-list').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $('#request-list').load(this.href);
});

$('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/review_request/module/review_request.list&user_token={{ user_token }}';

    var filter_email = $('#filter-email').val();

    if (filter_email) {
        url += '&filter_email=' + encodeURIComponent(filter_email);
    }

    var filter_order_id = $('#filter-order-id').val();

    if (filter_order_id) {
        url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
    }

    var filter_status = $('#filter-status').val();

    if (filter_status !== '') {
        url += '&filter_status=' + filter_status;
    }

    $('#request-list').load(url);
});

$('#request-list').on('click', '.btn-delete', function(e) {
    e.preventDefault();

    if (!confirm('{{ text_confirm }}')) {
        return;
    }

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        dataType: 'json',
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $(element).closest('tr').remove();
            }
        }
    });
});
//--></script>
{{ footer }}
