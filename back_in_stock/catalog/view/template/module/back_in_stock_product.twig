<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:16px 0;border:1px solid #eeeeee;border-radius:6px;">
  <tr>
    {% if image %}
      <td style="padding:12px;width:120px;vertical-align:middle;"><a href="{{ href }}"><img src="{{ image }}" width="120" height="120" alt="{{ name|e }}" style="display:block;border:0;width:120px;height:auto;"/></a></td>
    {% endif %}
    <td style="padding:12px;vertical-align:middle;font-size:15px;">
      <a href="{{ href }}" style="color:#222222;text-decoration:none;"><strong>{{ name|e }}</strong></a>
      <br/><span style="font-size:18px;color:#1f6feb;font-weight:bold;">{{ price }}</span>
    </td>
  </tr>
</table>
