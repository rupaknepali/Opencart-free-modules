<section class="faqschema mb-4">
  {% if heading %}<h2 class="h3 mt-4">{{ heading }}</h2>{% endif %}
  <div class="faqschema-list">
    {% for faq in faqs %}
      <details class="faqschema-item border-bottom py-2"{% if loop.first %} open{% endif %}>
        <summary class="fw-semibold py-1">{{ faq.question }}</summary>
        <div class="faqschema-answer pt-2">{{ faq.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>
{% if schema %}
<script type="application/ld+json">
{{ schema }}
</script>
{% endif %}
<style>
.faqschema summary { cursor: pointer; list-style: none; position: relative; padding-right: 2rem; }
.faqschema summary::-webkit-details-marker { display: none; }
.faqschema summary::after { content: "+"; position: absolute; right: .25rem; top: .1rem; font-size: 1.25rem; line-height: 1.5; font-weight: 400; }
.faqschema details[open] > summary::after { content: "\2212"; }
.faqschema summary:focus-visible { outline: 2px solid var(--bs-primary, #0d6efd); outline-offset: 2px; }
.faqschema-answer p:last-child { margin-bottom: .5rem; }
</style>
