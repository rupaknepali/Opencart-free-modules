<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <td class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></td>
        <td class="text-start">{{ column_question }}</td>
        <td class="text-start">{{ column_target }}</td>
        <td class="text-start">{{ column_type }}</td>
        <td class="text-end">{{ column_sort_order }}</td>
        <td class="text-start">{{ column_status }}</td>
        <td class="text-end">{{ column_action }}</td>
      </tr>
    </thead>
    <tbody>
      {% for faq in faqs %}
        <tr>
          <td class="text-center"><input type="checkbox" name="selected[]" value="{{ faq.faq_id }}" class="form-check-input"/></td>
          <td class="text-start">{{ faq.question }}</td>
          <td class="text-start">{{ faq.target }}</td>
          <td class="text-start">{{ faq.type }}</td>
          <td class="text-end">{{ faq.sort_order }}</td>
          <td class="text-start">{% if faq.status %}<span class="badge bg-success">{{ text_enabled }}</span>{% else %}<span class="badge bg-secondary">{{ text_disabled }}</span>{% endif %}</td>
          <td class="text-end"><a href="{{ faq.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a></td>
        </tr>
      {% else %}
        <tr>
          <td class="text-center" colspan="7">{{ text_no_results }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="row">
  <div class="col-sm-6 text-start">{{ pagination }}</div>
  <div class="col-sm-6 text-end">{{ results }}</div>
</div>
