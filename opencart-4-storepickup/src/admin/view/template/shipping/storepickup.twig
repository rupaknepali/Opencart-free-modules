{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_locations }}</legend>
            <p class="form-text">{{ help_locations }}</p>
            <div class="table-responsive">
              <table class="table table-bordered align-top">
                <thead>
                  <tr>
                    <td style="width: 16%;">{{ column_name }}</td>
                    <td style="width: 22%;">{{ column_address }}</td>
                    <td style="width: 20%;">{{ column_hours }}</td>
                    <td style="width: 13%;">{{ column_ready }}</td>
                    <td style="width: 8%;">{{ column_cost }}</td>
                    <td style="width: 13%;">{{ column_geo_zone }}</td>
                    <td class="text-center" style="width: 1px;">{{ column_status }}</td>
                    <td style="width: 1px;"></td>
                  </tr>
                </thead>
                <tbody id="locations">
                  {% set location_row = 0 %}
                  {% for location in shipping_storepickup_locations %}
                    <tr id="location-row-{{ location_row }}">
                      <td><input type="text" name="shipping_storepickup_locations[{{ location_row }}][name]" value="{{ location.name }}" id="input-location-{{ location_row }}" class="form-control"/><div id="error-location-{{ location_row }}" class="invalid-feedback"></div></td>
                      <td><textarea name="shipping_storepickup_locations[{{ location_row }}][address]" rows="2" class="form-control">{{ location.address }}</textarea></td>
                      <td><textarea name="shipping_storepickup_locations[{{ location_row }}][hours]" rows="2" class="form-control">{{ location.hours }}</textarea></td>
                      <td><input type="text" name="shipping_storepickup_locations[{{ location_row }}][ready]" value="{{ location.ready }}" class="form-control"/></td>
                      <td><input type="text" name="shipping_storepickup_locations[{{ location_row }}][cost]" value="{{ location.cost }}" class="form-control"/></td>
                      <td><select name="shipping_storepickup_locations[{{ location_row }}][geo_zone_id]" class="form-select">
                          <option value="0">{{ text_all_zones }}</option>
                          {% for geo_zone in geo_zones %}
                            <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == location.geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                          {% endfor %}
                        </select></td>
                      <td class="text-center"><input type="hidden" name="shipping_storepickup_locations[{{ location_row }}][status]" value="0"/><input type="checkbox" name="shipping_storepickup_locations[{{ location_row }}][status]" value="1" class="form-check-input mt-2"{% if location.status %} checked{% endif %}/></td>
                      <td><button type="button" onclick="$('#location-row-{{ location_row }}').remove();" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>
                    </tr>
                    {% set location_row = location_row + 1 %}
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="7"></td>
                    <td><button type="button" id="button-add-location" data-bs-toggle="tooltip" title="{{ button_add_location }}" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i></button></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_settings }}</legend>
            <div class="row mb-3 required">
              <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_storepickup_title" value="{{ shipping_storepickup_title }}" id="input-title" class="form-control"/><div id="error-title" class="invalid-feedback"></div></div>
            </div>
            <div class="row mb-3">
              <label for="input-instructions" class="col-sm-2 col-form-label">{{ entry_instructions }}</label>
              <div class="col-sm-10"><textarea name="shipping_storepickup_instructions" rows="2" id="input-instructions" class="form-control">{{ shipping_storepickup_instructions }}</textarea><div class="form-text">{{ help_instructions }}</div></div>
            </div>
            <div class="row mb-3">
              <label for="input-map" class="col-sm-2 col-form-label">{{ entry_map }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg"><input type="hidden" name="shipping_storepickup_map" value="0"/><input type="checkbox" name="shipping_storepickup_map" value="1" id="input-map" class="form-check-input"{% if shipping_storepickup_map %} checked{% endif %}/></div>
                <div class="form-text">{{ help_map }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
              <div class="col-sm-10">
                <select name="shipping_storepickup_tax_class_id" id="input-tax-class" class="form-select">
                  <option value="0">{{ text_none }}</option>
                  {% for tax_class in tax_classes %}
                    <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_storepickup_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                  {% endfor %}
                </select>
                <div class="form-text">{{ help_tax_class }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="shipping_storepickup_status" value="0"/><input type="checkbox" name="shipping_storepickup_status" value="1" id="input-status" class="form-check-input"{% if shipping_storepickup_status %} checked{% endif %}/></div></div>
            </div>
            <div class="row mb-3">
              <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_storepickup_sort_order" value="{{ shipping_storepickup_sort_order }}" id="input-sort-order" class="form-control"/></div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var location_row = {{ location_row }};

$('#button-add-location').on('click', function() {
    var r = location_row;
    var html = '<tr id="location-row-' + r + '">';
    html += '<td><input type="text" name="shipping_storepickup_locations[' + r + '][name]" value="" id="input-location-' + r + '" class="form-control"/><div id="error-location-' + r + '" class="invalid-feedback"></div></td>';
    html += '<td><textarea name="shipping_storepickup_locations[' + r + '][address]" rows="2" class="form-control"></textarea></td>';
    html += '<td><textarea name="shipping_storepickup_locations[' + r + '][hours]" rows="2" class="form-control"></textarea></td>';
    html += '<td><input type="text" name="shipping_storepickup_locations[' + r + '][ready]" value="" class="form-control"/></td>';
    html += '<td><input type="text" name="shipping_storepickup_locations[' + r + '][cost]" value="0" class="form-control"/></td>';
    html += '<td><select name="shipping_storepickup_locations[' + r + '][geo_zone_id]" class="form-select"><option value="0">{{ text_all_zones|escape('js') }}</option>';
    {% for geo_zone in geo_zones %}
    html += '<option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name|escape('js') }}</option>';
    {% endfor %}
    html += '</select></td>';
    html += '<td class="text-center"><input type="hidden" name="shipping_storepickup_locations[' + r + '][status]" value="0"/><input type="checkbox" name="shipping_storepickup_locations[' + r + '][status]" value="1" class="form-check-input mt-2" checked/></td>';
    html += '<td><button type="button" onclick="$(\'#location-row-' + r + '\').remove();" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>';
    html += '</tr>';

    $('#locations').append(html);

    location_row++;
});
//--></script>
{{ footer }}
