<div class="card mb-3" id="ordernotes">
  <div class="card-header"><i class="fa-solid fa-note-sticky"></i> {{ text_notes }} <small class="text-muted ms-2"><i class="fa-solid fa-lock"></i> {{ text_private }}</small></div>
  <div class="card-body">
    <div id="ordernotes-list">{{ list }}</div>
    {% if can_modify %}
      <div id="ordernotes-form">
        <label for="ordernotes-note" class="form-label">{{ entry_note }}</label>
        <textarea id="ordernotes-note" rows="3" maxlength="2000" class="form-control mb-2"></textarea>
        <div class="d-flex justify-content-between align-items-center">
          <div class="form-check">
            <input type="checkbox" id="ordernotes-pinned" value="1" class="form-check-input"/>
            <label for="ordernotes-pinned" class="form-check-label">{{ text_pin }}</label>
          </div>
          <button type="button" id="ordernotes-add" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> {{ button_add }}</button>
        </div>
      </div>
    {% endif %}
  </div>
</div>
<script type="text/javascript">
(function () {
    // No <form> here: the order page binds handlers to its own forms.
    var orderId = {{ order_id }};

    function send(url, data, button) {
        $.ajax({
            url: url,
            type: 'post',
            data: data,
            dataType: 'json',
            beforeSend: function () { $(button).button('loading'); },
            complete: function () { $(button).button('reset'); },
            success: function (json) {
                $('#ordernotes .alert-dismissible').remove();

                if (json['error']) {
                    $('#ordernotes-list').before('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                if (json['list'] !== undefined) {
                    $('#ordernotes-list').html(json['list']);
                }

                if (json['success'] && data.note !== undefined) {
                    $('#ordernotes-note').val('');
                    $('#ordernotes-pinned').prop('checked', false);
                }
            },
            error: function (xhr, status, error) { console.log(error); }
        });
    }

    $('#ordernotes-add').on('click', function () {
        send('{{ add }}', {order_id: orderId, note: $('#ordernotes-note').val(), pinned: $('#ordernotes-pinned').prop('checked') ? 1 : 0}, this);
    });

    $('#ordernotes-list').on('click', '.ordernotes-pin', function () {
        send('{{ pin }}', {ordernote_id: $(this).data('id'), pinned: $(this).data('pinned')}, this);
    });

    $('#ordernotes-list').on('click', '.ordernotes-delete', function () {
        if (confirm('{{ text_confirm|e('js') }}')) {
            send('{{ delete }}', {ordernote_id: $(this).data('id')}, this);
        }
    });
})();
</script>
