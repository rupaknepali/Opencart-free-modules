<style>
#rs-toast{position:fixed;left:20px;bottom:20px;z-index:1035;max-width:340px;display:flex;align-items:center;gap:12px;background:var(--bs-body-bg,#fff);color:var(--bs-body-color,#212529);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.18);padding:10px 36px 10px 10px;opacity:0;transform:translateY(12px);transition:opacity .3s,transform .3s;pointer-events:none}
#rs-toast.show{opacity:1;transform:none;pointer-events:auto}
#rs-toast img{width:56px;height:56px;border-radius:8px;object-fit:cover;flex:none}
#rs-toast a{color:inherit;text-decoration:none;font-size:14px;line-height:1.35}
#rs-toast button{position:absolute;top:4px;right:6px;border:0;background:none;font-size:20px;line-height:1;opacity:.6;cursor:pointer;padding:2px 6px}
@media (max-width:575.98px){ #rs-toast{left:12px;right:12px;bottom:12px;max-width:none}}
@media (prefers-reduced-motion:reduce){ #rs-toast{transition:none}}
</style>
<div id="rs-toast" role="status" aria-live="polite"><img alt=""><a href="#"></a><button type="button" aria-label="{{ text_close }}">&times;</button></div>
<script>
(function () {
  var toast = document.getElementById('rs-toast');
  if (!toast) return;
  try { if (sessionStorage.getItem('rs-off') == '1') return; } catch (e) {}
  var shown = 0, max = {{ max }}, i = 0, items = [], timer;
  toast.querySelector('button').addEventListener('click', function () {
    toast.classList.remove('show'); clearTimeout(timer);
    try { sessionStorage.setItem('rs-off', '1'); } catch (e) {}
  });
  function next() {
    if (shown >= max || !items.length) return;
    var item = items[i++ % items.length];
    toast.querySelector('img').src = item.image;
    toast.querySelector('a').href = item.href;
    toast.querySelector('a').textContent = item.text;
    toast.classList.add('show'); shown++;
    timer = setTimeout(function () { toast.classList.remove('show'); timer = setTimeout(next, {{ interval }} * 1000); }, 6000);
  }
  setTimeout(function () {
    fetch({{ feed|json_encode }}, {credentials: 'same-origin'}).then(function (r) { return r.json(); }).then(function (json) {
      items = json.items || []; next();
    }).catch(function () {});
  }, {{ delay }} * 1000);
})();
</script>
