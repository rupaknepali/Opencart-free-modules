{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-product" class="col-sm-3 col-form-label">{{ entry_product }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_salecountdown_product" value="0"/>
                <input type="checkbox" name="module_salecountdown_product" value="1" id="input-product" class="form-check-input"{% if module_salecountdown_product %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-card" class="col-sm-3 col-form-label">{{ entry_card }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_salecountdown_card" value="0"/>
                <input type="checkbox" name="module_salecountdown_card" value="1" id="input-card" class="form-check-input"{% if module_salecountdown_card %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_card }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-days" class="col-sm-3 col-form-label">{{ entry_days }}</label>
            <div class="col-sm-9">
              <input type="number" name="module_salecountdown_days" value="{{ module_salecountdown_days }}" min="0" id="input-days" class="form-control" style="max-width: 10rem;"/>
              <div class="form-text">{{ help_days }}</div>
              <div id="error-days" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_salecountdown_status" value="0"/>
                <input type="checkbox" name="module_salecountdown_status" value="1" id="input-status" class="form-check-input"{% if module_salecountdown_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
