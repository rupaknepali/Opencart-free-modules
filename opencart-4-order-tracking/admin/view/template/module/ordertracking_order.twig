<div class="card mb-3" id="ordertracking">
  <div class="card-header"><i class="fa-solid fa-truck-fast"></i> {{ text_tracking }}</div>
  <div class="card-body">
    <div id="ordertracking-list">{{ list }}</div>
    {% if can_modify %}
      <form id="form-ordertracking" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label for="input-ordertracking-carrier" class="form-label">{{ entry_carrier }}</label>
          <select name="carrier" id="input-ordertracking-carrier" class="form-select">
            {% for key, carrier in carriers %}
              <option value="{{ key }}">{{ carrier.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label for="input-ordertracking-number" class="form-label">{{ entry_tracking }}</label>
          <input type="text" name="tracking_number" id="input-ordertracking-number" class="form-control" autocomplete="off"/>
        </div>
        <div class="col-md-3">
          <div class="form-check form-switch">
            <input type="checkbox" value="1" id="input-ordertracking-history" class="form-check-input"{% if notify %} checked{% endif %}/>
            <label for="input-ordertracking-history" class="form-check-label">{{ entry_add_history }}</label>
          </div>
        </div>
        <div class="col-md-2 text-end">
          <input type="hidden" name="order_id" value="{{ order_id }}"/>
          <button type="submit" id="button-ordertracking" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> {{ button_add_tracking }}</button>
        </div>
        <div class="col-12 form-text mt-1">{{ text_history_note }}</div>
      </form>
    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
$('#form-ordertracking').on('submit', function(e) {
    e.preventDefault();

    var addHistory = $('#input-ordertracking-history').prop('checked');

    $.ajax({
        url: 'index.php?route=extension/ordertracking/module/ordertracking.add&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        data: $('#form-ordertracking').serialize(),
        beforeSend: function() {
            $('#button-ordertracking').button('loading');
        },
        complete: function() {
            $('#button-ordertracking').button('reset');
        },
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#ordertracking-list').html(json['list']);
                $('#input-ordertracking-number').val('');

                if (addHistory) {
                    // Hand over to OpenCart's own history form: it saves the entry and emails the customer.
                    {% if order_status_id %}$('#input-order-status').val('{{ order_status_id }}');{% endif %}
                    $('#input-notify').prop('checked', true);
                    $('#input-history').val(json['comment']);
                    $('#form-history').trigger('submit');
                } else {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#ordertracking-list').on('click', '.ordertracking-remove', function() {
    if (!confirm('{{ text_confirm_remove|escape('js') }}')) {
        return;
    }

    $.ajax({
        url: 'index.php?route=extension/ordertracking/module/ordertracking.remove&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        data: {order_id: '{{ order_id }}', order_tracking_id: $(this).val()},
        success: function(json) {
            if (json['error']) {
                alert(json['error']);
            }

            if (json['list']) {
                $('#ordertracking-list').html(json['list']);
            }
        }
    });
});
//--></script>
