{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <h5 class="mb-3">{{ text_badges }}</h5>
          <div class="row mb-3">
            <label for="input-sale" class="col-sm-3 col-form-label">{{ entry_sale }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_sale" value="0"/>
                <input type="checkbox" name="module_productbadges_sale" value="1" id="input-sale" class="form-check-input"{% if module_productbadges_sale %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_sale }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sale-format" class="col-sm-3 col-form-label">{{ entry_sale_format }}</label>
            <div class="col-sm-9">
              <select name="module_productbadges_sale_format" id="input-sale-format" class="form-select" style="max-width: 24rem;">
                <option value="percent"{% if module_productbadges_sale_format == 'percent' %} selected{% endif %}>{{ text_percent }}</option>
                <option value="word"{% if module_productbadges_sale_format == 'word' %} selected{% endif %}>{{ text_word }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-new" class="col-sm-3 col-form-label">{{ entry_new }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_new" value="0"/>
                <input type="checkbox" name="module_productbadges_new" value="1" id="input-new" class="form-check-input"{% if module_productbadges_new %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_new }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-new-days" class="col-sm-3 col-form-label">{{ entry_new_days }}</label>
            <div class="col-sm-9">
              <input type="number" name="module_productbadges_new_days" value="{{ module_productbadges_new_days }}" min="1" id="input-new-days" class="form-control" style="max-width: 10rem;"/>
              <div id="error-new-days" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-bestseller" class="col-sm-3 col-form-label">{{ entry_bestseller }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_bestseller" value="0"/>
                <input type="checkbox" name="module_productbadges_bestseller" value="1" id="input-bestseller" class="form-check-input"{% if module_productbadges_bestseller %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_bestseller }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-bestseller-limit" class="col-sm-3 col-form-label">{{ entry_bestseller_limit }}</label>
            <div class="col-sm-9">
              <input type="number" name="module_productbadges_bestseller_limit" value="{{ module_productbadges_bestseller_limit }}" min="1" id="input-bestseller-limit" class="form-control" style="max-width: 10rem;"/>
              <div id="error-bestseller" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-bestseller-days" class="col-sm-3 col-form-label">{{ entry_bestseller_days }}</label>
            <div class="col-sm-9">
              <input type="number" name="module_productbadges_bestseller_days" value="{{ module_productbadges_bestseller_days }}" min="1" id="input-bestseller-days" class="form-control" style="max-width: 10rem;"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-soldout" class="col-sm-3 col-form-label">{{ entry_soldout }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_soldout" value="0"/>
                <input type="checkbox" name="module_productbadges_soldout" value="1" id="input-soldout" class="form-check-input"{% if module_productbadges_soldout %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_soldout }}</div>
            </div>
          </div>
          <hr/>
          <h5 class="mb-3">{{ text_display }}</h5>
          <div class="row mb-3">
            <label for="input-position" class="col-sm-3 col-form-label">{{ entry_position }}</label>
            <div class="col-sm-9">
              <select name="module_productbadges_position" id="input-position" class="form-select" style="max-width: 24rem;">
                <option value="left"{% if module_productbadges_position == 'left' %} selected{% endif %}>{{ text_left }}</option>
                <option value="right"{% if module_productbadges_position == 'right' %} selected{% endif %}>{{ text_right }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-product-page" class="col-sm-3 col-form-label">{{ entry_product_page }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_product_page" value="0"/>
                <input type="checkbox" name="module_productbadges_product_page" value="1" id="input-product-page" class="form-check-input"{% if module_productbadges_product_page %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productbadges_status" value="0"/>
                <input type="checkbox" name="module_productbadges_status" value="1" id="input-status" class="form-check-input"{% if module_productbadges_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
