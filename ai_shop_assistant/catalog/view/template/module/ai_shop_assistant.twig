<div id="ai-assist" class="ai-assist" data-chat="{{ chat }}" data-reset="{{ reset }}">
  <button type="button" class="ai-assist-toggle" aria-expanded="false" aria-controls="ai-assist-panel" title="{{ text_open }}"><span aria-hidden="true">&#128172;</span><span class="ai-assist-sr">{{ text_open }}</span></button>
  <div id="ai-assist-panel" class="ai-assist-panel" role="dialog" aria-label="{{ title }}" hidden>
    <div class="ai-assist-header">
      <strong>{{ title }}</strong>
      <span>
        <button type="button" class="ai-assist-new" title="{{ text_new }}">&#8635;</button>
        <button type="button" class="ai-assist-close" title="{{ text_close }}">&times;</button>
      </span>
    </div>
    <div class="ai-assist-messages" aria-live="polite">
      <div class="ai-assist-msg ai-assist-bot">{{ welcome }}</div>
    </div>
    <form class="ai-assist-form">
      <label class="ai-assist-sr" for="ai-assist-input">{{ entry_message }}</label>
      <input type="text" id="ai-assist-input" maxlength="500" autocomplete="off" placeholder="{{ entry_message }}"/>
      <button type="submit">{{ text_send }}</button>
    </form>
    <div class="ai-assist-note">{{ text_ai }}</div>
  </div>
</div>
<style>
.ai-assist{position:fixed;right:16px;bottom:16px;z-index:1050;font-size:14px}
.ai-assist-toggle{width:56px;height:56px;border-radius:50%;border:0;background:{{ color }};color:#fff;font-size:24px;box-shadow:0 4px 12px rgba(0,0,0,.25);cursor:pointer}
.ai-assist-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.ai-assist-panel{position:absolute;right:0;bottom:68px;width:360px;max-width:calc(100vw - 32px);height:520px;max-height:calc(100vh - 100px);background:#fff;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}
.ai-assist-panel[hidden]{display:none}
.ai-assist-header{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:{{ color }};color:#fff}
.ai-assist-header button{background:none;border:0;color:#fff;font-size:20px;line-height:1;cursor:pointer;margin-left:6px}
.ai-assist-messages{flex:1;overflow-y:auto;padding:12px;background:#f6f7f9}
.ai-assist-msg{max-width:85%;margin-bottom:10px;padding:8px 12px;border-radius:12px;white-space:pre-wrap;word-wrap:break-word}
.ai-assist-bot{background:#fff;border:1px solid #e5e7eb}
.ai-assist-user{background:{{ color }};color:#fff;margin-left:auto}
.ai-assist-notice{font-size:12px;color:#6b7280;text-align:center;margin-bottom:10px}
.ai-assist-cards{display:flex;gap:8px;overflow-x:auto;margin:-4px 0 12px}
.ai-assist-card{flex:0 0 120px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:6px;text-decoration:none;color:#222;font-size:12px}
.ai-assist-card img{width:100%;height:auto;border-radius:4px}
.ai-assist-card strong{display:block;color:{{ color }}}
.ai-assist-form{display:flex;border-top:1px solid #e5e7eb}
.ai-assist-form input{flex:1;border:0;padding:12px;font-size:14px;min-width:0}
.ai-assist-form button{border:0;background:{{ color }};color:#fff;padding:0 16px;cursor:pointer}
.ai-assist-note{font-size:11px;color:#6b7280;padding:4px 10px 8px;background:#fff}
</style>
<script>
(function() {
    var root = document.getElementById('ai-assist');

    if (!root) {
        return;
    }

    var panel = root.querySelector('.ai-assist-panel');
    var toggle = root.querySelector('.ai-assist-toggle');
    var messages = root.querySelector('.ai-assist-messages');
    var form = root.querySelector('.ai-assist-form');
    var input = root.querySelector('#ai-assist-input');
    var busy = false;

    // Text is always added with textContent, never as HTML.
    function addMessage(type, text) {
        var div = document.createElement('div');

        div.className = type == 'notice' ? 'ai-assist-notice' : 'ai-assist-msg ai-assist-' + type;
        div.textContent = text;

        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;

        return div;
    }

    function addCards(cards) {
        if (!cards || !cards.length) {
            return;
        }

        var wrap = document.createElement('div');

        wrap.className = 'ai-assist-cards';

        cards.forEach(function(card) {
            var link = document.createElement('a');

            link.className = 'ai-assist-card';
            link.href = card.href;

            if (card.thumb) {
                var img = document.createElement('img');

                img.src = card.thumb;
                img.alt = '';
                link.appendChild(img);
            }

            var name = document.createElement('span');
            name.textContent = card.name;
            link.appendChild(name);

            var price = document.createElement('strong');
            price.textContent = card.price;
            link.appendChild(price);

            wrap.appendChild(link);
        });

        messages.appendChild(wrap);
        messages.scrollTop = messages.scrollHeight;
    }

    {{ history }}.forEach(function(item) {
        addMessage(item.role == 'user' ? 'user' : 'bot', item.text);
        addCards(item.cards);
    });

    function setOpen(open) {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');

        if (open) {
            input.focus();
        }
    }

    toggle.addEventListener('click', function() {
        setOpen(panel.hidden);
    });

    root.querySelector('.ai-assist-close').addEventListener('click', function() {
        setOpen(false);
    });

    root.querySelector('.ai-assist-new').addEventListener('click', function() {
        fetch(root.getAttribute('data-reset'), {method: 'POST', credentials: 'same-origin'});

        messages.querySelectorAll('.ai-assist-msg:not(:first-child), .ai-assist-cards, .ai-assist-notice').forEach(function(element) {
            element.remove();
        });
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();

        var text = input.value.trim();

        if (!text || busy) {
            return;
        }

        busy = true;
        input.value = '';

        addMessage('user', text);

        var typing = addMessage('bot', '{{ text_typing|escape('js') }}');

        var body = new URLSearchParams();
        body.append('message', text);

        fetch(root.getAttribute('data-chat'), {method: 'POST', body: body, credentials: 'same-origin'}).then(function(response) {
            return response.json();
        }).then(function(json) {
            typing.remove();

            if (json.notice) {
                addMessage('notice', json.notice);
            }

            if (json.error) {
                addMessage('bot', json.error);
            } else {
                addMessage('bot', json.reply);
                addCards(json.cards);
            }
        }).catch(function() {
            typing.remove();
            addMessage('bot', '{{ text_error|escape('js') }}');
        }).finally(function() {
            busy = false;
            input.focus();
        });
    });
})();
</script>
