{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <h5 class="mt-4 mb-3 border-bottom pb-2">{{ text_button }}</h5>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_whatsappchat_status" value="0"/>
                <input type="checkbox" name="module_whatsappchat_status" value="1" id="input-status" class="form-check-input"{% if module_whatsappchat_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-phone" class="col-sm-2 col-form-label">{{ entry_phone }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_phone" value="{{ module_whatsappchat_phone|e }}" id="input-phone" class="form-control" placeholder="14155550123" inputmode="numeric"/>
              <div id="error-phone" class="invalid-feedback"></div>
              <div class="form-text">{{ help_phone }}</div>
            </div>
          </div>
          {% if test_link %}<div class="row mb-3"><div class="offset-sm-2 col-sm-10"><a href="{{ test_link }}" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm"><i class="fa-brands fa-whatsapp"></i> {{ text_preview }}</a></div></div>{% endif %}
          <div class="row mb-3">
            <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_message" value="{{ module_whatsappchat_message|e }}" id="input-message" class="form-control"/>
              <div class="form-text">{{ help_message }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-label" class="col-sm-2 col-form-label">{{ entry_label }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_label" value="{{ module_whatsappchat_label|e }}" id="input-label" class="form-control"/>
              <div class="form-text">{{ help_label }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-greeting" class="col-sm-2 col-form-label">{{ entry_greeting }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_greeting" value="{{ module_whatsappchat_greeting|e }}" id="input-greeting" class="form-control"/>
              <div class="form-text">{{ help_greeting }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-position" class="col-sm-2 col-form-label">{{ entry_position }}</label>
            <div class="col-sm-10">
              <select name="module_whatsappchat_position" id="input-position" class="form-select">
                <option value="right"{% if module_whatsappchat_position == 'right' %} selected{% endif %}>{{ text_right }}</option>
                <option value="left"{% if module_whatsappchat_position == 'left' %} selected{% endif %}>{{ text_left }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-devices" class="col-sm-2 col-form-label">{{ entry_devices }}</label>
            <div class="col-sm-10">
              <select name="module_whatsappchat_devices" id="input-devices" class="form-select">
                <option value="all"{% if module_whatsappchat_devices == 'all' %} selected{% endif %}>{{ text_everywhere }}</option>
                <option value="mobile"{% if module_whatsappchat_devices == 'mobile' %} selected{% endif %}>{{ text_mobile }}</option>
                <option value="desktop"{% if module_whatsappchat_devices == 'desktop' %} selected{% endif %}>{{ text_desktop }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-color" class="col-sm-2 col-form-label">{{ entry_color }}</label>
            <div class="col-sm-10">
              <input type="color" name="module_whatsappchat_color" value="{{ module_whatsappchat_color }}" id="input-color" class="form-control form-control-color"/>
            </div>
          </div>
          <h5 class="mt-4 mb-3 border-bottom pb-2">{{ text_product }}</h5>
          <div class="row mb-3">
            <label for="input-product-button" class="col-sm-2 col-form-label">{{ entry_product_button }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_whatsappchat_product_button" value="0"/>
                <input type="checkbox" name="module_whatsappchat_product_button" value="1" id="input-product-button" class="form-check-input"{% if module_whatsappchat_product_button %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-ask" class="col-sm-2 col-form-label">{{ entry_ask }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_ask" value="{{ module_whatsappchat_ask|e }}" id="input-ask" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-product-message" class="col-sm-2 col-form-label">{{ entry_product_message }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_product_message" value="{{ module_whatsappchat_product_message|e }}" id="input-product-message" class="form-control"/>
              <div class="form-text">{{ help_product_message }}</div>
            </div>
          </div>
          <h5 class="mt-4 mb-3 border-bottom pb-2">{{ text_hours }}</h5>
          <p class="text-muted">{{ text_timezone }}</p>
          <div class="row mb-3">
            <label for="input-hours-status" class="col-sm-2 col-form-label">{{ entry_hours_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_whatsappchat_hours_status" value="0"/>
                <input type="checkbox" name="module_whatsappchat_hours_status" value="1" id="input-hours-status" class="form-check-input"{% if module_whatsappchat_hours_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-2 col-form-label fw-bold text-sm-end">{{ entry_days }}</div>
            <div class="col-sm-10 pt-2">
              {% for key, day in days %}
                <div class="form-check form-check-inline">
                  <input type="checkbox" name="module_whatsappchat_days[]" value="{{ key }}" id="input-day-{{ key }}" class="form-check-input"{% if key in module_whatsappchat_days %} checked{% endif %}/>
                  <label for="input-day-{{ key }}" class="form-check-label">{{ day }}</label>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-open" class="col-sm-2 col-form-label">{{ entry_open }}</label>
            <div class="col-sm-4"><input type="time" name="module_whatsappchat_open" value="{{ module_whatsappchat_open }}" id="input-open" class="form-control"/></div>
            <label for="input-close" class="col-sm-2 col-form-label">{{ entry_close }}</label>
            <div class="col-sm-4"><input type="time" name="module_whatsappchat_close" value="{{ module_whatsappchat_close }}" id="input-close" class="form-control"/></div>
            <div class="offset-sm-2 col-sm-10"><div id="error-time" class="invalid-feedback"></div></div>
          </div>
          <div class="row mb-3">
            <label for="input-offline" class="col-sm-2 col-form-label">{{ entry_offline }}</label>
            <div class="col-sm-10">
              <select name="module_whatsappchat_offline" id="input-offline" class="form-select">
                <option value="note"{% if module_whatsappchat_offline == 'note' %} selected{% endif %}>{{ text_offline_note }}</option>
                <option value="hide"{% if module_whatsappchat_offline == 'hide' %} selected{% endif %}>{{ text_offline_hide }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-offline-text" class="col-sm-2 col-form-label">{{ entry_offline_text }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_whatsappchat_offline_text" value="{{ module_whatsappchat_offline_text|e }}" id="input-offline-text" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
