{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_indexnow_status" value="0"/><input type="checkbox" name="module_indexnow_status" value="1" id="input-status" class="form-check-input"{% if module_indexnow_status %} checked{% endif %}/></div></div>
          </div>
          <div class="row mb-3">
            <label for="input-endpoint" class="col-sm-2 col-form-label">{{ entry_endpoint }}</label>
            <div class="col-sm-10">
              <select name="module_indexnow_endpoint" id="input-endpoint" class="form-select">
                {% for url, name in endpoints %}
                  <option value="{{ url }}"{% if url == module_indexnow_endpoint %} selected{% endif %}>{{ name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_endpoint }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_types }}</label>
            <div class="col-sm-10">
              {% for type in ['product', 'category', 'information', 'manufacturer'] %}
                <div class="form-check form-check-inline">
                  <input type="checkbox" name="module_indexnow_types[]" value="{{ type }}" id="input-type-{{ type }}" class="form-check-input"{% if type in module_indexnow_types %} checked{% endif %}/>
                  <label for="input-type-{{ type }}" class="form-check-label">{{ attribute(_context, 'text_' ~ type) }}</label>
                </div>
              {% endfor %}
              <div class="form-text">{{ help_types }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" value="{{ key }}" id="input-key" class="form-control font-monospace" readonly/>
                <button type="button" id="button-regenerate" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate"></i> {{ button_regenerate }}</button>
              </div>
              <div class="form-text">
                {% if key_root %}<i class="fa-solid fa-circle-check text-success"></i> {{ text_key_root }}{% else %}<i class="fa-solid fa-circle-info text-warning"></i> {{ text_key_route }}{% endif %}
                <a href="{{ key_url }}" id="link-key" target="_blank" rel="noopener">{{ text_open_key }}</a>. {{ help_key }}
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <div class="float-end"><button type="button" id="button-submit-all" class="btn btn-sm btn-primary"><i class="fa-solid fa-paper-plane"></i> {{ button_submit_all }}</button></div>
        <i class="fa-solid fa-list"></i> {{ text_log }}
      </div>
      <div class="card-body p-0" id="indexnow-log"></div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#indexnow-log').load('{{ log|replace({'&amp;': '&'}) }}');

$('#button-submit-all').on('click', function() {
    if (!confirm('{{ text_confirm_all|escape('js') }}')) {
        return;
    }

    var button = $(this);

    $.ajax({
        url: '{{ submit_all|replace({'&amp;': '&'}) }}',
        dataType: 'json',
        beforeSend: function() { button.button('loading'); },
        complete: function() { button.button('reset'); },
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            $('#indexnow-log').load('{{ log|replace({'&amp;': '&'}) }}');
        }
    });
});

$('#button-regenerate').on('click', function() {
    $.ajax({
        url: '{{ regenerate|replace({'&amp;': '&'}) }}',
        dataType: 'json',
        success: function(json) {
            if (json['key']) {
                $('#input-key').val(json['key']);
                $('#link-key').attr('href', json['key_url']);
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
        }
    });
});
//--></script>
{{ footer }}
