{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
            <div class="col-sm-10">
              <textarea name="module_announcebar_message" rows="3" id="input-message" class="form-control">{{ module_announcebar_message }}</textarea>
              <div class="form-text">{{ help_message }}</div>
              <div id="error-message" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-link-text" class="col-sm-2 col-form-label">{{ entry_link_text }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_announcebar_link_text" value="{{ module_announcebar_link_text }}" id="input-link-text" class="form-control"/>
              <div class="form-text">{{ help_link_text }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-link-url" class="col-sm-2 col-form-label">{{ entry_link_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_announcebar_link_url" value="{{ module_announcebar_link_url }}" id="input-link-url" class="form-control"/>
              <div class="form-text">{{ help_link_url }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-background" class="col-sm-2 col-form-label">{{ entry_background }}</label>
            <div class="col-sm-10">
              <input type="color" name="module_announcebar_background" value="{{ module_announcebar_background }}" id="input-background" class="form-control form-control-color" style="max-width: 12rem;"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-color" class="col-sm-2 col-form-label">{{ entry_color }}</label>
            <div class="col-sm-10">
              <input type="color" name="module_announcebar_color" value="{{ module_announcebar_color }}" id="input-color" class="form-control form-control-color" style="max-width: 12rem;"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-date-start" class="col-sm-2 col-form-label">{{ entry_date_start }}</label>
            <div class="col-sm-10">
              <input type="date" name="module_announcebar_date_start" value="{{ module_announcebar_date_start }}" id="input-date-start" class="form-control" style="max-width: 12rem;"/>
              <div class="form-text">{{ help_date_start }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-date-end" class="col-sm-2 col-form-label">{{ entry_date_end }}</label>
            <div class="col-sm-10">
              <input type="date" name="module_announcebar_date_end" value="{{ module_announcebar_date_end }}" id="input-date-end" class="form-control" style="max-width: 12rem;"/>
              <div class="form-text">{{ help_date_end }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-dismiss" class="col-sm-2 col-form-label">{{ entry_dismiss }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_announcebar_dismiss" value="0"/>
                <input type="checkbox" name="module_announcebar_dismiss" value="1" id="input-dismiss" class="form-check-input"{% if module_announcebar_dismiss %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_announcebar_status" value="0"/>
                <input type="checkbox" name="module_announcebar_status" value="1" id="input-status" class="form-check-input"{% if module_announcebar_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
