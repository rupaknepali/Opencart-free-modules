{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-total" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-gift"></i> {{ text_info }}</div>
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-total" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="total_giftwrap_status" value="0"/><input type="checkbox" name="total_giftwrap_status" value="1" id="input-status" class="form-check-input"{% if total_giftwrap_status %} checked{% endif %}/></div></div>
          </div>
          <div class="row mb-3">
            <label for="input-price" class="col-sm-2 col-form-label">{{ entry_price }}</label>
            <div class="col-sm-10"><input type="text" name="total_giftwrap_price" value="{{ total_giftwrap_price }}" id="input-price" class="form-control" style="max-width: 10rem;"/><div id="error-price" class="invalid-feedback"></div><div class="form-text">{{ help_price }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10"><select name="total_giftwrap_tax_class_id" id="input-tax-class" class="form-select" style="max-width: 20rem;"><option value="0">{{ text_none }}</option>{% for tax_class in tax_classes %}<option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == total_giftwrap_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>{% endfor %}</select></div>
          </div>
          <div class="row mb-3">
            <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="total_giftwrap_message" value="0"/><input type="checkbox" name="total_giftwrap_message" value="1" id="input-message" class="form-check-input"{% if total_giftwrap_message %} checked{% endif %}/></div><div class="form-text">{{ help_message }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-length" class="col-sm-2 col-form-label">{{ entry_length }}</label>
            <div class="col-sm-10"><input type="number" name="total_giftwrap_length" value="{{ total_giftwrap_length }}" min="20" max="1000" id="input-length" class="form-control" style="max-width: 10rem;"/></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_description }}</label>
            <div class="col-sm-10">
              {% for language in languages %}<div class="input-group mb-1"><span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name }}"/></span><input type="text" name="total_giftwrap_description[{{ language.language_id }}]" value="{{ total_giftwrap_description[language.language_id] ?? '' }}" class="form-control"/></div>{% endfor %}
              <div class="form-text">{{ help_description }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10"><input type="number" name="total_giftwrap_sort_order" value="{{ total_giftwrap_sort_order }}" id="input-sort-order" class="form-control" style="max-width: 10rem;"/><div class="form-text">{{ help_sort_order }}</div></div>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-box-open"></i> {{ text_recent }}</div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th class="ps-3">{{ column_order }}</th><th>{{ column_customer }}</th><th>{{ column_message }}</th><th>{{ column_status }}</th><th>{{ column_date }}</th></tr></thead>
          <tbody>
            {% for order in orders %}
              <tr><td class="ps-3"><a href="{{ order.href }}">#{{ order.order_id }}</a></td><td>{{ order.customer|e }}</td><td class="fst-italic">{{ order.message|e|nl2br }}</td><td>{{ order.status }}</td><td>{{ order.date }}</td></tr>
            {% else %}
              <tr><td colspan="5" class="text-center text-body-secondary p-3">{{ text_no_orders }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{{ footer }}
