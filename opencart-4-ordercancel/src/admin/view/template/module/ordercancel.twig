{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_restock }}</div>
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_ordercancel_status" value="0"/>
                <input type="checkbox" name="module_ordercancel_status" value="1" id="input-status" class="form-check-input"{% if module_ordercancel_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-2 col-form-label fw-bold text-sm-end">{{ entry_statuses }}</div>
            <div class="col-sm-10">
              <div id="input-statuses" class="form-control p-0" style="height:150px;overflow:auto">
                {% for order_status in order_statuses %}
                  <div class="form-check m-2">
                    <input type="checkbox" name="module_ordercancel_statuses[]" value="{{ order_status.order_status_id }}" id="input-status-{{ order_status.order_status_id }}" class="form-check-input"{% if order_status.order_status_id in module_ordercancel_statuses %} checked{% endif %}/>
                    <label for="input-status-{{ order_status.order_status_id }}" class="form-check-label">{{ order_status.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div id="error-statuses" class="invalid-feedback"></div>
              <div class="form-text">{{ help_statuses }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-hours" class="col-sm-2 col-form-label">{{ entry_hours }}</label>
            <div class="col-sm-10">
              <input type="number" min="0" name="module_ordercancel_hours" value="{{ module_ordercancel_hours }}" id="input-hours" class="form-control"/>
              <div class="form-text">{{ text_no_limit }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-cancel-status" class="col-sm-2 col-form-label">{{ entry_cancel_status }}</label>
            <div class="col-sm-10">
              <select name="module_ordercancel_cancel_status" id="input-cancel-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == module_ordercancel_cancel_status %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div id="error-cancel-status" class="invalid-feedback"></div>
              <div class="form-text">{{ help_cancel_status }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-reasons" class="col-sm-2 col-form-label">{{ entry_reasons }}</label>
            <div class="col-sm-10">
              <textarea name="module_ordercancel_reasons" rows="5" id="input-reasons" class="form-control">{{ module_ordercancel_reasons|e }}</textarea>
              <div class="form-text">{{ help_reasons }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-reason-required" class="col-sm-2 col-form-label">{{ entry_reason_required }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_ordercancel_reason_required" value="0"/>
                <input type="checkbox" name="module_ordercancel_reason_required" value="1" id="input-reason-required" class="form-check-input"{% if module_ordercancel_reason_required %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-notify" class="col-sm-2 col-form-label">{{ entry_notify }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_ordercancel_notify" value="0"/>
                <input type="checkbox" name="module_ordercancel_notify" value="1" id="input-notify" class="form-check-input"{% if module_ordercancel_notify %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_notify }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-ban"></i> {{ text_recent }}</div>
      <div class="card-body">
        {% if recent %}
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr><th>{{ column_order }}</th><th>{{ column_customer }}</th><th>{{ column_reason }}</th><th>{{ column_comment }}</th><th>{{ column_date }}</th></tr></thead>
              <tbody>
                {% for row in recent %}
                  <tr><td><a href="{{ row.href }}">#{{ row.order_id }}</a></td><td>{{ row.customer|e }}</td><td>{{ row.reason|e }}</td><td>{{ row.comment|e }}</td><td>{{ row.date }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p class="mb-0 text-muted">{{ text_no_recent }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
