{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus"></i></a>
        <button type="submit" form="form-chart" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="return confirm('{{ text_confirm }}');" class="btn btn-danger"><i class="fa-regular fa-trash-can"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <ul class="nav nav-tabs">
      <li class="nav-item"><a href="#tab-charts" data-bs-toggle="tab" class="nav-link active">{{ text_charts }}</a></li>
      <li class="nav-item"><a href="#tab-settings" data-bs-toggle="tab" class="nav-link">{{ text_settings }}</a></li>
    </ul>
    <div class="tab-content">
      <div id="tab-charts" class="tab-pane active">
        <div class="card border-top-0 rounded-top-0">
          <div id="chart" class="card-body">{{ list }}</div>
        </div>
      </div>
      <div id="tab-settings" class="tab-pane">
        <div class="card border-top-0 rounded-top-0">
          <div class="card-body">
            <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <div class="row mb-3">
                <label for="input-label" class="col-sm-2 col-form-label">{{ entry_label }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_sizechart_label" value="{{ module_sizechart_label }}" id="input-label" class="form-control"/>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_sizechart_status" value="0"/>
                    <input type="checkbox" name="module_sizechart_status" value="1" id="input-status" class="form-check-input"{% if module_sizechart_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="text-end">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{ button_save }}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
