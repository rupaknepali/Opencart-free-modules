{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-table-cells-large"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10"><input type="text" name="name" value="{{ name }}" id="input-name" class="form-control"/><div id="error-name" class="invalid-feedback"></div></div>
          </div>
          <div class="row mb-3 required">
            <label for="input-category" class="col-sm-2 col-form-label">{{ entry_category }}</label>
            <div class="col-sm-10"><select name="category_id" id="input-category" class="form-select"><option value="0"></option>{% for category in categories %}<option value="{{ category.category_id }}"{% if category.category_id == category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select><div id="error-category" class="invalid-feedback"></div></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">{% for language in languages %}<div class="input-group mb-1"><span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name }}"/></span><input type="text" name="title[{{ language.language_id }}]" value="{{ title[language.language_id] ?? '' }}" class="form-control"/></div>{% endfor %}<div class="form-text">{{ help_title }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-brands" class="col-sm-2 col-form-label">{{ entry_brands }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="brands" value="0"/><input type="checkbox" name="brands" value="1" id="input-brands" class="form-check-input"{% if brands %} checked{% endif %}/></div><div class="form-text">{{ help_brands }}</div></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_image }}</label>
            <div class="col-sm-10">
              <div class="card image" style="width: 140px;">
                <img src="{{ thumb }}" alt="" id="thumb-image" data-oc-placeholder="{{ placeholder }}" class="card-img-top"/>
                <input type="hidden" name="image" value="{{ image }}" id="input-image"/>
                <div class="card-body p-1 d-grid gap-1">
                  <button type="button" data-oc-toggle="image" data-oc-target="#input-image" data-oc-thumb="#thumb-image" class="btn btn-primary btn-sm"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                  <button type="button" data-oc-toggle="clear" data-oc-target="#input-image" data-oc-thumb="#thumb-image" class="btn btn-warning btn-sm"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                </div>
              </div>
              <div class="form-text">{{ help_image }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-link" class="col-sm-2 col-form-label">{{ entry_link }}</label>
            <div class="col-sm-10"><input type="text" name="link" value="{{ link }}" id="input-link" class="form-control"/><div id="error-link" class="invalid-feedback"></div><div class="form-text">{{ help_link }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-limit" class="col-sm-2 col-form-label">{{ entry_limit }}</label>
            <div class="col-sm-10"><input type="number" name="limit" value="{{ limit }}" min="1" max="12" id="input-limit" class="form-control" style="max-width: 8rem;"/></div>
          </div>
          <div class="row mb-3">
            <label for="input-sort" class="col-sm-2 col-form-label">{{ entry_sort }}</label>
            <div class="col-sm-10"><select name="sort" id="input-sort" class="form-select" style="max-width: 20rem;">{% for value, label in {'p.date_added': text_newest, 'p.sort_order': text_sort_order, 'p.viewed': text_viewed, 'rating': text_rating} %}<option value="{{ value }}"{% if sort == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="status" value="0"/><input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/></div></div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
