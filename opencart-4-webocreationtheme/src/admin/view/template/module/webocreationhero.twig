{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-images"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10"><input type="text" name="name" value="{{ name }}" id="input-name" class="form-control"/><div id="error-name" class="invalid-feedback"></div></div>
          </div>
          <div class="row mb-3 required">
            <label for="input-banner" class="col-sm-2 col-form-label">{{ entry_banner }}</label>
            <div class="col-sm-10"><select name="banner_id" id="input-banner" class="form-select"><option value="0"></option>{% for banner in banners %}<option value="{{ banner.banner_id }}"{% if banner.banner_id == banner_id %} selected{% endif %}>{{ banner.name }}</option>{% endfor %}</select><div id="error-banner" class="invalid-feedback"></div><div class="form-text">{{ help_banner }}</div></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_size }}</label>
            <div class="col-sm-10"><div class="input-group" style="max-width: 20rem;"><input type="number" name="width" value="{{ width }}" class="form-control" aria-label="Width"/><span class="input-group-text">×</span><input type="number" name="height" value="{{ height }}" class="form-control" aria-label="Height"/></div><div class="form-text">{{ help_size }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-tabs" class="col-sm-2 col-form-label">{{ entry_tabs }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="tabs" value="0"/><input type="checkbox" name="tabs" value="1" id="input-tabs" class="form-check-input"{% if tabs %} checked{% endif %}/></div></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_panel }}</label>
            <div class="col-sm-10">{% for value in ['none', 'articles', 'specials', 'latest'] %}<div class="form-check"><input type="radio" name="panel" value="{{ value }}" id="input-panel-{{ value }}" class="form-check-input"{% if panel == value %} checked{% endif %}/><label for="input-panel-{{ value }}" class="form-check-label">{{ attribute(_context, 'text_' ~ value) }}</label></div>{% endfor %}</div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_panel_title }}</label>
            <div class="col-sm-10">{% for language in languages %}<div class="input-group mb-1"><span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name }}"/></span><input type="text" name="panel_title[{{ language.language_id }}]" value="{{ panel_title[language.language_id] ?? '' }}" placeholder="Today's deals" class="form-control"/></div>{% endfor %}</div>
          </div>
          <div class="row mb-3">
            <label for="input-panel-limit" class="col-sm-2 col-form-label">{{ entry_panel_limit }}</label>
            <div class="col-sm-10"><input type="number" name="panel_limit" value="{{ panel_limit }}" min="1" max="8" id="input-panel-limit" class="form-control" style="max-width: 8rem;"/></div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="status" value="0"/><input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/></div></div>
          </div>
          <input type="hidden" name="module_id" value="{{ module_id }}" id="input-module-id"/>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
