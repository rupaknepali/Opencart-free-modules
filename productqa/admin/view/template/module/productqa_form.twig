{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-answer" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-comments"></i> {{ text_edit_question }}</div>
      <div class="card-body">
        <form id="form-answer" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_product }}</label>
            <div class="col-sm-10">
              <p class="form-control-plaintext"><a href="{{ product_href }}" target="_blank">{{ product }}</a><br/><small class="text-muted">{{ text_asked|format(name, date_added) }}{% if customer %} · <a href="{{ customer }}" target="_blank">{{ text_view_customer }}</a>{% endif %}</small></p>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-question" class="col-sm-2 col-form-label">{{ entry_question }}</label>
            <div class="col-sm-10">
              <textarea name="question" rows="3" id="input-question" class="form-control">{{ question }}</textarea>
              <div id="error-question" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-answer" class="col-sm-2 col-form-label">{{ entry_answer }}</label>
            <div class="col-sm-10">
              <textarea name="answer" rows="6" id="input-answer" class="form-control">{{ answer }}</textarea>
              <div id="error-answer" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-published" class="col-sm-2 col-form-label">{{ entry_published }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-published" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_published }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
