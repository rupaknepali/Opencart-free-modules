{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-question" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="return confirm('{{ text_confirm }}');" class="btn btn-danger" id="button-delete"><i class="fa-regular fa-trash-can"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <ul class="nav nav-tabs">
      <li class="nav-item"><a href="#tab-questions" data-bs-toggle="tab" class="nav-link active">{{ text_questions }}</a></li>
      <li class="nav-item"><a href="#tab-settings" data-bs-toggle="tab" class="nav-link">{{ text_settings }}</a></li>
    </ul>
    <div class="tab-content">
      <div id="tab-questions" class="tab-pane active">
        <div class="card border-top-0 rounded-top-0">
          <div class="card-body">
            <div class="btn-group mb-3" role="group" id="filter">
              <a href="{{ list_url }}" class="btn btn-outline-secondary{% if not filter %} active{% endif %}">{{ text_all }}</a>
              <a href="{{ list_url }}&filter=unanswered" class="btn btn-outline-secondary{% if filter == 'unanswered' %} active{% endif %}">{{ text_unanswered }}</a>
              <a href="{{ list_url }}&filter=hidden" class="btn btn-outline-secondary{% if filter == 'hidden' %} active{% endif %}">{{ text_hidden }}</a>
              <a href="{{ list_url }}&filter=published" class="btn btn-outline-secondary{% if filter == 'published' %} active{% endif %}">{{ text_published }}</a>
            </div>
            <div id="question">{{ list }}</div>
          </div>
        </div>
      </div>
      <div id="tab-settings" class="tab-pane">
        <div class="card border-top-0 rounded-top-0">
          <div class="card-body">
            <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-3 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_productqa_status" value="0"/>
                    <input type="checkbox" name="module_productqa_status" value="1" id="input-status" class="form-check-input"{% if module_productqa_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-login" class="col-sm-3 col-form-label">{{ entry_login }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_productqa_login" value="0"/>
                    <input type="checkbox" name="module_productqa_login" value="1" id="input-login" class="form-check-input"{% if module_productqa_login %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-limit" class="col-sm-3 col-form-label">{{ entry_limit }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_productqa_limit" value="{{ module_productqa_limit }}" min="1" id="input-limit" class="form-control" style="max-width: 10rem;"/>
                </div>
              </div>
              <div class="text-end">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{ button_save }}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
// Filter buttons and page links reload just the list.
$('#filter a').on('click', function (e) {
  e.preventDefault();
  $('#filter a').removeClass('active');
  $(this).addClass('active');
  $('#question').load(this.href);
});

$('#question').on('click', '.pagination a', function (e) {
  e.preventDefault();
  $('#question').load(this.href);
});

//--></script>
{{ footer }}
