<form id="form-question" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#question">
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></th>
          <th>{{ column_question }}</th>
          <th>{{ column_product }}</th>
          <th>{{ column_name }}</th>
          <th>{{ column_status }}</th>
          <th>{{ column_date_added }}</th>
          <th class="text-end">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if questions %}
          {% for question in questions %}
            <tr>
              <td class="text-center"><input type="checkbox" name="selected[]" value="{{ question.question_id }}" class="form-check-input"/></td>
              <td>{{ question.question|e }}</td>
              <td>{{ question.product }}</td>
              <td>{{ question.name }}</td>
              <td>
                {% if question.status %}
                  <span class="badge bg-success">{{ text_published }}</span>
                {% elseif question.answered %}
                  <span class="badge bg-secondary">{{ text_hidden }}</span>
                {% else %}
                  <span class="badge bg-danger">{{ text_unanswered }}</span>
                {% endif %}
              </td>
              <td>{{ question.date_added }}</td>
              <td class="text-end"><a href="{{ question.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td class="text-center" colspan="7">{{ text_no_questions }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="row">
    <div class="col-sm-6 text-start">{{ pagination }}</div>
    <div class="col-sm-6 text-end">{{ results }}</div>
  </div>
</form>
