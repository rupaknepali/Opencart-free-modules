{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info|format(layout) }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_groups }}</legend>
            {% for key in ['price', 'brand', 'attribute', 'filters', 'stock', 'rating'] %}
              <div class="row mb-3">
                <label for="input-{{ key }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_' ~ key) }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="{{ key }}" value="0"/>
                    <input type="checkbox" name="{{ key }}" value="1" id="input-{{ key }}" class="form-check-input"{% if attribute(_context, key) %} checked{% endif %}/>
                  </div>
                  {% if attribute(_context, 'help_' ~ key) != 'help_' ~ key %}<div class="form-text">{{ attribute(_context, 'help_' ~ key) }}</div>{% endif %}
                </div>
              </div>
            {% endfor %}
          </fieldset>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_attributes }}</label>
            <div class="col-sm-9">
              <div class="form-control p-2" style="height: 180px; overflow: auto;">
                {% for item in all_attributes %}
                  <div class="form-check">
                    <input type="checkbox" name="attributes[]" value="{{ item.attribute_id }}" id="input-attribute-{{ item.attribute_id }}" class="form-check-input"{% if item.attribute_id in attributes %} checked{% endif %}/>
                    <label for="input-attribute-{{ item.attribute_id }}" class="form-check-label">{{ item.group_name }} &gt; {{ item.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div class="form-text">{{ help_attributes }}</div>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-limit" class="col-sm-3 col-form-label">{{ entry_limit }}</label>
            <div class="col-sm-9">
              <input type="number" name="limit" value="{{ limit }}" min="3" max="50" id="input-limit" class="form-control"/>
              <div id="error-limit" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
