<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th>{{ column_email }}</th>
        <th class="d-none d-lg-table-cell">{{ column_products }}</th>
        <th class="text-end">{{ column_total }}</th>
        <th class="text-center">{{ column_stage }}</th>
        <th class="text-center d-none d-lg-table-cell">{{ column_clicks }}</th>
        <th>{{ column_status }}</th>
        <th>{{ column_order }}</th>
        <th class="d-none d-lg-table-cell">{{ column_date_modified }}</th>
        <th class="text-end">{{ column_action }}</th>
      </tr>
    </thead>
    <tbody>
      {% if carts %}
        {% for cart in carts %}
          <tr>
            <td>{{ cart.email }}{% if cart.firstname %}<br/><small class="text-muted">{{ cart.firstname }}</small>{% endif %}</td>
            <td class="d-none d-lg-table-cell"><small>{{ cart.products }}</small></td>
            <td class="text-end">{{ cart.total }}</td>
            <td class="text-center">{{ cart.emails }}</td>
            <td class="text-center d-none d-lg-table-cell">{{ cart.clicks }}</td>
            <td>
              {% if cart.status_id == 1 %}
                <span class="badge bg-success">{{ cart.status }}</span>
              {% elseif cart.status_id == 2 %}
                <span class="badge bg-info">{{ cart.status }}</span>
              {% elseif cart.status_id == 0 %}
                <span class="badge bg-warning text-dark">{{ cart.status }}</span>
              {% else %}
                <span class="badge bg-secondary">{{ cart.status }}</span>
              {% endif %}
            </td>
            <td>{% if cart.order %}<a href="{{ cart.order }}" target="_blank">#{{ cart.order_id }}</a><br/><small>{{ cart.order_total }}</small>{% endif %}</td>
            <td class="d-none d-lg-table-cell">{{ cart.date_modified }}</td>
            <td class="text-end"><a href="{{ cart.delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn-sm btn-delete"><i class="fa-regular fa-trash-can"></i></a></td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td class="text-center" colspan="9">{{ text_no_results }}</td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
<div class="row">
  <div class="col-sm-6 text-start">{{ pagination }}</div>
  <div class="col-sm-6 text-end">{{ results }}</div>
</div>
