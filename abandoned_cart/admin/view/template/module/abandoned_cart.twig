{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_cron_info|format(cron) }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ text_general }}</a></li>
          <li class="nav-item"><a href="#tab-emails" data-bs-toggle="tab" class="nav-link">{{ text_emails }}</a></li>
          <li class="nav-item"><a href="#tab-coupon" data-bs-toggle="tab" class="nav-link">{{ text_coupon }}</a></li>
          <li class="nav-item"><a href="#tab-report" data-bs-toggle="tab" class="nav-link">{{ text_report }}</a></li>
        </ul>
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_abandoned_cart_status" value="0"/>
                    <input type="checkbox" name="module_abandoned_cart_status" value="1" id="input-status" class="form-check-input"{% if module_abandoned_cart_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-min-total" class="col-sm-2 col-form-label">{{ entry_min_total }}</label>
                <div class="col-sm-10">
                  <input type="number" step="0.01" min="0" name="module_abandoned_cart_min_total" value="{{ module_abandoned_cart_min_total }}" id="input-min-total" class="form-control"/>
                  <div class="form-text">{{ help_min_total|format(default_currency) }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_consent }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_abandoned_cart_consent" value="0"/>
                    <input type="checkbox" name="module_abandoned_cart_consent" value="1" id="input-consent" class="form-check-input"{% if module_abandoned_cart_consent %} checked{% endif %}/>
                  </div>
                  <div class="form-text">{{ help_consent }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-retention" class="col-sm-2 col-form-label">{{ entry_retention }}</label>
                <div class="col-sm-10">
                  <input type="number" min="15" name="module_abandoned_cart_retention" value="{{ module_abandoned_cart_retention }}" id="input-retention" class="form-control"/>
                  <div class="form-text">{{ help_retention }}</div>
                  <div id="error-retention" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-bcc" class="col-sm-2 col-form-label">{{ entry_bcc }}</label>
                <div class="col-sm-10">
                  <input type="email" name="module_abandoned_cart_bcc" value="{{ module_abandoned_cart_bcc }}" id="input-bcc" class="form-control"/>
                  <div class="form-text">{{ help_bcc }}</div>
                  <div id="error-bcc" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
            <div id="tab-emails" class="tab-pane">
              <div class="alert alert-light">{{ text_placeholders }}</div>
              {% for key, stage in stages %}
                <fieldset>
                  <legend>{{ text_stage|format(key) }}</legend>
                  <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">{{ entry_stage_status }}</label>
                    <div class="col-sm-10">
                      <div class="form-check form-switch form-switch-lg">
                        <input type="hidden" name="module_abandoned_cart_stage[{{ key }}][status]" value="0"/>
                        <input type="checkbox" name="module_abandoned_cart_stage[{{ key }}][status]" value="1" class="form-check-input"{% if stage.status %} checked{% endif %}/>
                      </div>
                    </div>
                  </div>
                  <div class="row mb-3">
                    <label for="input-stage-{{ key }}-delay" class="col-sm-2 col-form-label">{{ entry_delay }}</label>
                    <div class="col-sm-10">
                      <div class="input-group">
                        <input type="number" min="0" name="module_abandoned_cart_stage[{{ key }}][delay]" value="{{ stage.delay }}" id="input-stage-{{ key }}-delay" class="form-control"/>
                        <span class="input-group-text">{{ text_hours }}</span>
                      </div>
                      <div class="form-text">{{ help_delay }}</div>
                    </div>
                  </div>
                  <div class="row mb-3 required">
                    <label for="input-stage-{{ key }}-subject" class="col-sm-2 col-form-label">{{ entry_subject }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_abandoned_cart_stage[{{ key }}][subject]" value="{{ stage.subject }}" id="input-stage-{{ key }}-subject" class="form-control"/>
                      <div id="error-stage-{{ key }}-subject" class="invalid-feedback"></div>
                    </div>
                  </div>
                  <div class="row mb-3 required">
                    <label for="input-stage-{{ key }}-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
                    <div class="col-sm-10">
                      <textarea name="module_abandoned_cart_stage[{{ key }}][message]" rows="10" id="input-stage-{{ key }}-message" data-oc-toggle="ckeditor" class="form-control">{{ stage.message }}</textarea>
                      <div id="error-stage-{{ key }}-message" class="invalid-feedback"></div>
                    </div>
                  </div>
                </fieldset>
              {% endfor %}
            </div>
            <div id="tab-coupon" class="tab-pane">
              <div class="alert alert-light">{{ text_coupon_info }}</div>
              <div class="row mb-3">
                <label for="input-coupon-stage" class="col-sm-2 col-form-label">{{ entry_coupon_stage }}</label>
                <div class="col-sm-10">
                  <select name="module_abandoned_cart_coupon_stage" id="input-coupon-stage" class="form-select">
                    <option value="0">{{ text_no_coupon }}</option>
                    {% for key, stage in stages %}
                      <option value="{{ key }}"{% if key == module_abandoned_cart_coupon_stage %} selected{% endif %}>{{ text_stage|format(key) }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-coupon-discount" class="col-sm-2 col-form-label">{{ entry_coupon_discount }}</label>
                <div class="col-sm-10">
                  <input type="number" step="0.01" min="0" max="100" name="module_abandoned_cart_coupon_discount" value="{{ module_abandoned_cart_coupon_discount }}" id="input-coupon-discount" class="form-control"/>
                  <div id="error-coupon-discount" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-coupon-days" class="col-sm-2 col-form-label">{{ entry_coupon_days }}</label>
                <div class="col-sm-10">
                  <input type="number" min="1" name="module_abandoned_cart_coupon_days" value="{{ module_abandoned_cart_coupon_days }}" id="input-coupon-days" class="form-control"/>
                </div>
              </div>
            </div>
            <div id="tab-report" class="tab-pane">
              <div class="row text-center mb-4">
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_captured }}</div><div class="text-muted">{{ text_captured }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_emails }}</div><div class="text-muted">{{ text_emails_sent }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_recovered }}</div><div class="text-muted">{{ text_recovered }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_rate }}</div><div class="text-muted">{{ text_rate }}</div></div></div>
                <div class="col"><div class="border rounded p-3"><div class="fs-3 fw-bold">{{ stat_revenue }}</div><div class="text-muted">{{ text_revenue }}</div></div></div>
              </div>
              <div class="row g-2 mb-3">
                <div class="col-sm-5"><input type="text" value="" placeholder="{{ entry_filter_email }}" id="filter-email" class="form-control"/></div>
                <div class="col-sm-5">
                  <select id="filter-status" class="form-select">
                    <option value="">{{ text_all }}</option>
                    {% for status_id in 0..4 %}
                      <option value="{{ status_id }}">{{ attribute(_context, 'text_status_' ~ status_id) }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-sm-2 d-grid"><button type="button" id="button-filter" class="btn btn-light"><i class="fa-solid fa-filter"></i> {{ button_filter }}</button></div>
              </div>
              <div id="cart-list">{{ list }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('textarea[data-oc-toggle=\'ckeditor\']').ckeditor({
    allowedContent: true
});

$('#cart-list').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $('#cart-list').load(this.href);
});

$('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/abandoned_cart/module/abandoned_cart.list&user_token={{ user_token }}';

    var filter_email = $('#filter-email').val();

    if (filter_email) {
        url += '&filter_email=' + encodeURIComponent(filter_email);
    }

    var filter_status = $('#filter-status').val();

    if (filter_status !== '') {
        url += '&filter_status=' + filter_status;
    }

    $('#cart-list').load(url);
});

$('#cart-list').on('click', '.btn-delete', function(e) {
    e.preventDefault();

    if (!confirm('{{ text_confirm }}')) {
        return;
    }

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        dataType: 'json',
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $(element).closest('tr').remove();
            }
        }
    });
});
//--></script>
{{ footer }}
