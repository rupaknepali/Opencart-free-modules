<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:16px 0;">
  {% for product in products %}
    <tr>
      <td style="padding:8px 8px 8px 0;border-bottom:1px solid #eeeeee;width:80px;vertical-align:top;">{% if product.thumb %}<img src="{{ product.thumb }}" width="80" height="80" alt="{{ product.name }}" style="display:block;border:0;"/>{% endif %}</td>
      <td style="padding:8px;border-bottom:1px solid #eeeeee;vertical-align:top;font-size:14px;">
        <strong>{{ product.name }}</strong>
        {% for option in product.option %}
          <br/><small style="color:#666666;">{{ option.name }}: {{ option.value }}</small>
        {% endfor %}
        <br/><small style="color:#666666;">&times; {{ product.quantity }}</small>
      </td>
      <td style="padding:8px 0 8px 8px;border-bottom:1px solid #eeeeee;vertical-align:top;text-align:right;font-size:14px;white-space:nowrap;">{{ product.total }}</td>
    </tr>
  {% endfor %}
  <tr>
    <td></td>
    <td style="padding:8px;text-align:right;font-size:14px;"><strong>{{ text_total }}</strong></td>
    <td style="padding:8px 0 8px 8px;text-align:right;font-size:14px;white-space:nowrap;"><strong>{{ cart_total }}</strong></td>
  </tr>
</table>
