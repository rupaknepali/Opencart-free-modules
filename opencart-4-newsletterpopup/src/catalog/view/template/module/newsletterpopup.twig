<style>
.np-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:1055;display:flex;align-items:center;justify-content:center;padding:16px}
.np-backdrop[hidden]{display:none}
.np-dialog{position:relative;background:var(--bs-body-bg,#fff);color:var(--bs-body-color,#212529);border-radius:14px;max-width:440px;width:100%;padding:28px 26px 22px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.np-dialog h2{font-size:1.5rem;margin:0 32px 8px 0}
.np-close{position:absolute;top:10px;right:12px;border:0;background:none;font-size:28px;line-height:1;color:inherit;opacity:.6;padding:4px 8px;cursor:pointer}
.np-close:hover,.np-close:focus-visible{opacity:1}
.np-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.np-code{font-family:var(--bs-font-monospace,monospace);font-size:1.4rem;letter-spacing:2px;border:2px dashed var(--bs-success,#198754);border-radius:8px;padding:8px 14px;display:inline-block;margin-top:8px}
@media (max-width:575.98px){
  .np-backdrop{align-items:flex-end;padding:0}
  .np-dialog{border-radius:16px 16px 0 0;max-width:none;padding:22px 18px 18px}
  .np-dialog h2{font-size:1.25rem}
}
</style>
<div id="np" class="np-backdrop" hidden>
  <div class="np-dialog" role="dialog" aria-modal="true" aria-labelledby="np-title">
    <button type="button" class="np-close" aria-label="{{ text_close }}">&times;</button>
    <h2 id="np-title">{{ title|e }}</h2>
    <div class="np-body">
      {% if text %}<p class="text-body-secondary">{{ text|e }}</p>{% endif %}
      <div class="np-form">
        <label for="np-email" class="visually-hidden">{{ text_email }}</label>
        <input type="email" id="np-email" name="email" autocomplete="email" placeholder="{{ text_email }}" class="form-control form-control-lg mb-2" required/>
        <div class="np-hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"/></div>
        <div id="np-error-email" class="invalid-feedback"></div>
        {% if consent %}
          <div class="form-check mb-2 small">
            <input type="checkbox" id="np-consent" name="consent" value="1" class="form-check-input"/>
            <label for="np-consent" class="form-check-label">{{ consent|e }}</label>
            <div id="np-error-consent" class="invalid-feedback"></div>
          </div>
        {% endif %}
        <button type="button" id="np-submit" class="btn btn-primary btn-lg w-100">{{ button|e }}</button>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var box = document.getElementById('np');
  if (!box) return;
  var KEY = 'np_hide', days = {{ days }}, delay = {{ delay }}, exitIntent = {{ exit ? 'true' : 'false' }};
  function hidden() { return document.cookie.split('; ').indexOf(KEY + '=1') > -1; }
  function remember() {
    if (days > 0) document.cookie = KEY + '=1; max-age=' + (days * 86400) + '; path=/; SameSite=Lax';
  }
  if (hidden()) return;
  var shown = false, lastFocus = null;
  function show() {
    if (shown || hidden()) return;
    shown = true;
    lastFocus = document.activeElement;
    box.hidden = false;
    document.getElementById('np-email').focus();
  }
  function close() {
    box.hidden = true;
    remember();
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  setTimeout(show, delay * 1000);
  if (exitIntent && window.matchMedia && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.addEventListener('mouseout', function (e) { if (!e.relatedTarget && e.clientY <= 0) show(); });
  }
  box.querySelector('.np-close').addEventListener('click', close);
  box.addEventListener('click', function (e) { if (e.target === box) close(); });
  document.addEventListener('keydown', function (e) {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      // Keep keyboard focus inside the dialog.
      var f = box.querySelectorAll('button, input:not([tabindex="-1"]), a[href]');
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  function error(field, message) {
    var input = document.getElementById('np-' + field), div = document.getElementById('np-error-' + field);
    if (input) input.classList.add('is-invalid');
    if (div) { div.textContent = message; div.classList.add('d-block'); }
  }
  function submit() {
    var button = document.getElementById('np-submit');
    var data = new FormData();
    box.querySelectorAll('input[name]').forEach(function (input) {
      input.classList.remove('is-invalid');
      if (input.type !== 'checkbox' || input.checked) data.append(input.name, input.value);
    });
    box.querySelectorAll('.invalid-feedback').forEach(function (d) { d.classList.remove('d-block'); });
    button.disabled = true;
    fetch('{{ action|e('js') }}'.replace(/&amp;/g, '&'), {method: 'POST', body: data, credentials: 'same-origin'})
      .then(function (r) { return r.json(); })
      .then(function (json) {
        button.disabled = false;
        if (json.error) { for (var k in json.error) error(k, json.error[k]); return; }
        remember();
        var body = box.querySelector('.np-body');
        body.innerHTML = '';
        var p = document.createElement('p');
        p.textContent = json.success;
        p.setAttribute('role', 'status');
        body.appendChild(p);
        if (json.coupon) {
          var code = document.createElement('div');
          code.className = 'np-code';
          code.textContent = json.coupon;
          body.appendChild(code);
        }
      })
      .catch(function () { button.disabled = false; });
  }
  document.getElementById('np-submit').addEventListener('click', submit);
  document.getElementById('np-email').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); submit(); } });
})();
</script>
