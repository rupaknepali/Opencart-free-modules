{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_reviewreply_status" value="0"/>
                <input type="checkbox" name="module_reviewreply_status" value="1" id="input-status" class="form-check-input"{% if module_reviewreply_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-author" class="col-sm-2 col-form-label">{{ entry_author }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_reviewreply_author" value="{{ module_reviewreply_author|e }}" placeholder="{{ store_name|e }}" id="input-author" class="form-control"/>
              <div class="form-text">{{ help_author }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-heading" class="col-sm-2 col-form-label">{{ entry_heading }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_reviewreply_heading" value="{{ module_reviewreply_heading|e }}" placeholder="" id="input-heading" class="form-control"/>
              <div class="form-text">{{ help_heading }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-notify" class="col-sm-2 col-form-label">{{ entry_notify }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_reviewreply_notify" value="0"/>
                <input type="checkbox" name="module_reviewreply_notify" value="1" id="input-notify" class="form-check-input"{% if module_reviewreply_notify %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_notify }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-comments"></i> {{ text_waiting }}</div>
      <div class="card-body">
        {% if waiting %}
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>{{ column_product }}</th><th>{{ column_author }}</th><th>{{ column_rating }}</th><th>{{ column_text }}</th><th>{{ column_date }}</th><th></th></tr></thead>
              <tbody>
                {% for review in waiting %}
                  <tr>
                    <td>{{ review.product|e }}</td>
                    <td>{{ review.author|e }}</td>
                    <td class="text-nowrap{% if review.rating <= 3 %} text-danger{% endif %}">{% for i in 1..5 %}<i class="fa-{{ i <= review.rating ? 'solid' : 'regular' }} fa-star"></i>{% endfor %}</td>
                    <td>{{ review.text|e }}</td>
                    <td class="text-nowrap">{{ review.date }}</td>
                    <td class="text-end"><a href="{{ review.edit }}" class="btn btn-sm btn-primary"><i class="fa-solid fa-reply"></i> {{ text_reply }}</a></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p class="mb-0 text-muted">{{ text_no_waiting }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
