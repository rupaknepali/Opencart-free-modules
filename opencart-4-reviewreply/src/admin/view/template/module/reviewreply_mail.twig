<!DOCTYPE html>
<html><head><meta charset="UTF-8"></head>
<body style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1f2328;line-height:1.5;max-width:600px">
<p>{{ intro|e }}</p>
<div style="border-left:4px solid #0d6efd;background:#f3f6fa;padding:12px 16px;margin:16px 0">{{ reply|e|nl2br }}</div>
<p style="color:#57606a"><strong>{{ text_review }}:</strong><br>{{ review|e|nl2br }}</p>
