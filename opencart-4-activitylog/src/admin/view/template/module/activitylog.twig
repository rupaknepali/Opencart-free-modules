{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-clock-rotate-left"></i> {{ text_info }}</div>
    <ul class="nav nav-tabs">
      <li class="nav-item"><a href="#tab-log" data-bs-toggle="tab" class="nav-link active"><i class="fa-solid fa-list"></i> {{ text_log }}</a></li>
      <li class="nav-item"><a href="#tab-settings" data-bs-toggle="tab" class="nav-link"><i class="fa-solid fa-gear"></i> {{ text_settings }}</a></li>
    </ul>
    <div class="tab-content">
      <div id="tab-log" class="tab-pane active">
        <div class="card border-top-0 rounded-top-0">
          <div class="card-body">
            <div class="row g-2 mb-3" id="filter">
              <div class="col-md-2"><label class="form-label small" for="filter-user">{{ entry_user }}</label><select id="filter-user" name="filter_user_id" class="form-select form-select-sm"><option value="">{{ text_all }}</option>{% for user in users %}<option value="{{ user.user_id }}">{{ user.username|e }}</option>{% endfor %}</select></div>
              <div class="col-md-2"><label class="form-label small" for="filter-action">{{ entry_action }}</label><select id="filter-action" name="filter_action" class="form-select form-select-sm"><option value="">{{ text_all }}</option>{% for action in ['add', 'edit', 'delete', 'copy', 'status', 'login', 'login_failed'] %}<option value="{{ action }}">{{ attribute(_context, 'action_' ~ action) }}</option>{% endfor %}</select></div>
              <div class="col-md-2"><label class="form-label small" for="filter-object">{{ entry_object }}</label><select id="filter-object" name="filter_object" class="form-select form-select-sm"><option value="">{{ text_all }}</option>{% for object in objects %}<option value="{{ object }}">{{ object }}</option>{% endfor %}</select></div>
              <div class="col-md-2"><label class="form-label small" for="filter-keyword">{{ entry_keyword }}</label><input type="text" id="filter-keyword" name="filter_keyword" class="form-control form-control-sm"/></div>
              <div class="col-md-1"><label class="form-label small" for="filter-from">{{ entry_date_from }}</label><input type="date" id="filter-from" name="filter_date_from" class="form-control form-control-sm"/></div>
              <div class="col-md-1"><label class="form-label small" for="filter-to">{{ entry_date_to }}</label><input type="date" id="filter-to" name="filter_date_to" class="form-control form-control-sm"/></div>
              <div class="col-md-2 d-flex align-items-end"><button type="button" id="button-filter" class="btn btn-sm btn-light w-100"><i class="fa-solid fa-filter"></i> {{ text_filter }}</button></div>
            </div>
            <div id="activitylog">{{ log }}</div>
          </div>
        </div>
      </div>
      <div id="tab-settings" class="tab-pane">
        <div class="card border-top-0 rounded-top-0">
          <div class="card-body">
            <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_activitylog_status" value="0"/><input type="checkbox" name="module_activitylog_status" value="1" id="input-status" class="form-check-input"{% if module_activitylog_status %} checked{% endif %}/></div></div>
              </div>
              <div class="row mb-3">
                <label for="input-retention" class="col-sm-2 col-form-label">{{ entry_retention }}</label>
                <div class="col-sm-10"><input type="number" name="module_activitylog_retention" value="{{ module_activitylog_retention }}" min="7" max="3650" id="input-retention" class="form-control" style="max-width: 8rem;"/><div class="form-text">{{ help_retention }}</div></div>
              </div>
              <div class="row mb-3">
                <label for="input-skip" class="col-sm-2 col-form-label">{{ entry_skip }}</label>
                <div class="col-sm-10"><textarea name="module_activitylog_skip" rows="8" id="input-skip" class="form-control font-monospace">{{ module_activitylog_skip|e }}</textarea><div class="form-text">{{ help_skip }}</div></div>
              </div>
              <div class="text-end"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{ button_save }}</button></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
    var url = '{{ list|replace({'&amp;': '&'}) }}';

    $('#filter').find('select, input').each(function() {
        if ($(this).val()) {
            url += '&' + this.name + '=' + encodeURIComponent($(this).val());
        }
    });

    $('#activitylog').load(url);
});

$('#activitylog').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $('#activitylog').load(this.href);
});
//--></script>
{{ footer }}
