{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-download"></i> {{ text_export }}</div>
      <div class="card-body">
        <p>{{ text_export_info }}</p>
        <a href="{{ export }}" class="btn btn-primary"><i class="fa-solid fa-file-csv"></i> {{ button_export }}</a>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-upload"></i> {{ text_import }}</div>
      <div class="card-body">
        <p>{{ text_import_info }}</p>
        <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_backup }}</div>
        <form id="form-import" action="{{ import }}" method="post" enctype="multipart/form-data">
          <div class="row mb-3">
            <label for="input-file" class="col-sm-2 col-form-label">{{ entry_file }}</label>
            <div class="col-sm-10">
              <input type="file" name="file" accept=".csv,text/csv" id="input-file" class="form-control"/>
              <div class="form-text">{{ help_file|format(max_size) }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-match" class="col-sm-2 col-form-label">{{ entry_match }}</label>
            <div class="col-sm-10">
              <select name="match" id="input-match" class="form-select">
                <option value="product_id">product_id</option>
                <option value="model">model</option>
                <option value="sku">sku</option>
              </select>
              <div class="form-text">{{ help_match }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_apply }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="checkbox" name="apply" value="1" id="input-apply" class="form-check-input"/>
              </div>
              <div class="form-text">{{ help_apply }}</div>
            </div>
          </div>
          <div class="text-end">
            <button type="submit" id="button-import" class="btn btn-primary"><i class="fa-solid fa-upload"></i> {{ button_import }}</button>
          </div>
        </form>
        <div id="result" class="mt-4"></div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#form-import').on('submit', function(e) {
    e.preventDefault();

    var form = this;

    $.ajax({
        url: $(form).attr('action'),
        type: 'post',
        data: new FormData(form),
        dataType: 'json',
        cache: false,
        contentType: false,
        processData: false,
        beforeSend: function() {
            $('#button-import').button('loading');
            $('#result').html('');
        },
        complete: function() {
            $('#button-import').button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $('#result').html(json['html']);

                // After saving, go back to preview mode so the same file isn't applied twice by accident.
                $('#input-apply').prop('checked', false);
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
