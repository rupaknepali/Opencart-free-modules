<div class="alert alert-{{ type }} alert-dismissible rounded-0 mb-0 text-center oc-couponlink" role="status">
  <i class="fa-solid fa-{{ type == 'success' ? 'tag' : 'circle-exclamation' }}"></i> {{ message }}
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ cl_close }}"></button>
</div>
