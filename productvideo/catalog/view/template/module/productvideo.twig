<div class="oc-videos">
  {% for video in videos %}
    <div class="oc-video mb-3">
      <button type="button" class="oc-video-play" data-embed="{{ video.embed }}" aria-label="{{ pv_play }}: {{ video.title }}"{% if video.thumb %} style="background-image: url('{{ video.thumb }}');"{% endif %}>
        <span class="oc-video-icon" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3S12.7.3 7.5 1.7a8.5 8.5 0 0 0-6 6C.3 12.9.3 24 .3 24s0 11.1 1.2 16.3a8.5 8.5 0 0 0 6 6c5.2 1.4 26.5 1.4 26.5 1.4s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6c1.2-5.2 1.2-16.3 1.2-16.3s0-11.1-1.2-16.3z" fill="#212121" fill-opacity=".85"/><path d="M45 24 27 14v20z" fill="#fff"/></svg></span>
      </button>
      {% if video.title %}<p class="small text-muted mt-1 mb-0">{{ video.title }}</p>{% endif %}
    </div>
  {% endfor %}
</div>
<style>
.oc-video-play { position: relative; display: block; width: 100%; max-width: 820px; aspect-ratio: 16 / 9; border: 0; padding: 0; background: #111 center / cover no-repeat; cursor: pointer; border-radius: .375rem; overflow: hidden; }
.oc-video-play .oc-video-icon { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); transition: transform .15s; }
.oc-video-play:hover .oc-video-icon, .oc-video-play:focus .oc-video-icon { transform: translate(-50%, -50%) scale(1.1); }
.oc-video iframe { width: 100%; max-width: 820px; aspect-ratio: 16 / 9; border: 0; border-radius: .375rem; }
</style>
<script type="text/javascript"><!--
// Swap the thumbnail for the real player only on click: no video scripts or cookies load before that.
document.querySelectorAll('.oc-video-play').forEach(function (button) {
  button.addEventListener('click', function () {
    var iframe = document.createElement('iframe');
    iframe.src = button.getAttribute('data-embed');
    iframe.title = button.getAttribute('aria-label');
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    button.replaceWith(iframe);
  });
});
//--></script>
