{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_info }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <h5 class="mb-3">{{ text_videos }}</h5>
          <div class="table-responsive">
            <table id="videos" class="table table-bordered">
              <thead>
                <tr>
                  <th style="width: 26%;">{{ column_product }}</th>
                  <th>{{ column_url }}</th>
                  <th style="width: 22%;">{{ column_title }}</th>
                  <th style="width: 6rem;">{{ column_sort_order }}</th>
                  <th style="width: 1px;"></th>
                </tr>
              </thead>
              <tbody>
                {% set video_row = 0 %}
                {% for video in videos %}
                  <tr id="video-row-{{ video_row }}">
                    <td>
                      <input type="text" value="{{ video.product }}" placeholder="{{ column_product }}" id="input-video-{{ video_row }}-product" data-oc-target="autocomplete-video-{{ video_row }}" class="form-control" autocomplete="off"/>
                      <input type="hidden" name="video[{{ video_row }}][product_id]" value="{{ video.product_id }}"/>
                      <ul id="autocomplete-video-{{ video_row }}" class="dropdown-menu"></ul>
                      <div id="error-video-{{ video_row }}-product" class="invalid-feedback"></div>
                    </td>
                    <td>
                      <input type="text" name="video[{{ video_row }}][url]" value="{{ video.url }}" placeholder="https://www.youtube.com/watch?v=..." id="input-video-{{ video_row }}-url" class="form-control"/>
                      <div id="error-video-{{ video_row }}-url" class="invalid-feedback"></div>
                    </td>
                    <td><input type="text" name="video[{{ video_row }}][title]" value="{{ video.title }}" class="form-control"/></td>
                    <td><input type="number" name="video[{{ video_row }}][sort_order]" value="{{ video.sort_order }}" class="form-control"/></td>
                    <td><button type="button" onclick="$('#video-row-{{ video_row }}').remove();" data-bs-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>
                  </tr>
                  {% set video_row = video_row + 1 %}
                {% endfor %}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="4">{% if not videos %}<span class="text-muted" id="no-videos">{{ text_no_videos }}</span>{% endif %}</td>
                  <td><button type="button" onclick="addVideo();" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i></button></td>
                </tr>
              </tfoot>
            </table>
          </div>
          <hr/>
          <div class="row mb-3">
            <label for="input-position" class="col-sm-2 col-form-label">{{ entry_position }}</label>
            <div class="col-sm-10">
              <select name="module_productvideo_position" id="input-position" class="form-select">
                <option value="tab"{% if module_productvideo_position == 'tab' %} selected{% endif %}>{{ text_tab }}</option>
                <option value="image"{% if module_productvideo_position == 'image' %} selected{% endif %}>{{ text_image }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_productvideo_status" value="0"/>
                <input type="checkbox" name="module_productvideo_status" value="1" id="input-status" class="form-check-input"{% if module_productvideo_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var video_row = {{ video_row }};

// Product search, the same autocomplete OpenCart's own product form uses.
function productAutocomplete(row) {
  $('#input-video-' + row + '-product').autocomplete({
    'source': function (request, response) {
      $.ajax({
        url: 'index.php?route=catalog/product.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function (json) {
          response($.map(json, function (item) {
            return {label: item['name'], value: item['product_id']};
          }));
        }
      });
    },
    'select': function (item) {
      $('#input-video-' + row + '-product').val(item['label']);
      $('input[name=\'video[' + row + '][product_id]\']').val(item['value']);
    }
  });
}

function addVideo() {
  $('#no-videos').remove();

  var html = '<tr id="video-row-' + video_row + '">';
  html += '<td><input type="text" value="" placeholder="{{ column_product|e('js') }}" id="input-video-' + video_row + '-product" data-oc-target="autocomplete-video-' + video_row + '" class="form-control" autocomplete="off"/>';
  html += '<input type="hidden" name="video[' + video_row + '][product_id]" value=""/><ul id="autocomplete-video-' + video_row + '" class="dropdown-menu"></ul><div id="error-video-' + video_row + '-product" class="invalid-feedback"></div></td>';
  html += '<td><input type="text" name="video[' + video_row + '][url]" value="" placeholder="https://www.youtube.com/watch?v=..." id="input-video-' + video_row + '-url" class="form-control"/><div id="error-video-' + video_row + '-url" class="invalid-feedback"></div></td>';
  html += '<td><input type="text" name="video[' + video_row + '][title]" value="" class="form-control"/></td>';
  html += '<td><input type="number" name="video[' + video_row + '][sort_order]" value="0" class="form-control"/></td>';
  html += '<td><button type="button" onclick="$(\'#video-row-' + video_row + '\').remove();" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>';
  html += '</tr>';

  $('#videos tbody').append(html);

  productAutocomplete(video_row);

  video_row++;
}

for (var i = 0; i < video_row; i++) {
  productAutocomplete(i);
}
//--></script>
{{ footer }}
